<Project>
  <!--
    EDIABAS mode (BMW's own module programs, run through EdiabasLib) is compiled in on every OS when the
    EdiabasLib sources are present in external/ediabaslib (run scripts/get-ediabaslib.sh or .ps1 once).
    Without them Klemme15 builds with its native protocol stack only.
  -->
  <PropertyGroup>
    <Klemme15Ediabas Condition="Exists('$(MSBuildThisFileDirectory)..\external\ediabaslib\EdiabasLib\EdiabasLib\EdiabasNet.cs')">true</Klemme15Ediabas>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Klemme15Ediabas)' == 'true'">
    <DefineConstants>$(DefineConstants);EDIABAS</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(Klemme15Ediabas)' == 'true'">
    <ProjectReference Include="$(MSBuildThisFileDirectory)..\src\Klemme15.Ediabas\Klemme15.Ediabas.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)..\src\Shared\*.cs" LinkBase="Shared" />
  </ItemGroup>
</Project>
