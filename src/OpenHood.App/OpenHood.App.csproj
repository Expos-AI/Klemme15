<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\..\build\Ediabas.props" />
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>OpenHood</AssemblyName>
    <RootNamespace>OpenHood.App</RootNamespace>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.2.3" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.3" />
    <!-- Avalonia 11.2 pulls Tmds.DBus.Protocol 0.20.0 (GHSA-xrw6-gwf8-vvr9); 0.21.3 is the patched version. -->
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.21.3" />
    <PackageReference Include="Avalonia.Diagnostics" Version="11.2.3" Condition="'$(Configuration)' == 'Debug'" />
  </ItemGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\OpenHood.Core\OpenHood.Core.csproj" />
    <ProjectReference Include="..\OpenHood.Protocols\OpenHood.Protocols.csproj" />
    <ProjectReference Include="..\OpenHood.Data\OpenHood.Data.csproj" />
    <ProjectReference Include="..\OpenHood.Serial\OpenHood.Serial.csproj" />
  </ItemGroup>
</Project>
