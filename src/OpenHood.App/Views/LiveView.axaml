<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OpenHood.App.ViewModels"
             xmlns:c="using:OpenHood.App.Controls"
             x:Class="OpenHood.App.Views.LiveView"
             x:DataType="vm:LiveViewModel">
  <Grid ColumnDefinitions="260,*" Margin="32,28">
    <!-- Parameter picker -->
    <DockPanel Margin="0,0,20,0">
      <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,12">
        <TextBlock Classes="h1" Text="Live data" />
        <TextBlock Classes="muted" Text="Pick values to watch." />
      </StackPanel>
      <TextBlock DockPanel.Dock="Top" Classes="muted" Text="{Binding EmptyText}" TextWrapping="Wrap" IsVisible="{Binding !HasParameters}" />
      <ScrollViewer>
        <ItemsControl ItemsSource="{Binding Parameters}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:LiveParameterViewModel">
              <CheckBox IsChecked="{Binding IsSelected}" Content="{Binding Name}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </DockPanel>

    <!-- Gauges -->
    <DockPanel Grid.Column="1">
      <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,16">
        <Button Classes="accent" Content="Start" Command="{Binding StartCommand}" Padding="18,9" />
        <Button Content="Stop" Command="{Binding StopCommand}" Padding="14,9" />
        <Button Content="Record" Command="{Binding RecordCommand}" />
        <Button Content="Save recording (CSV)" Command="{Binding SaveRecordingCommand}" />
        <TextBlock Text="● REC" Foreground="{DynamicResource BadBrush}" VerticalAlignment="Center" IsVisible="{Binding IsRecording}" />
        <TextBlock Classes="muted" Text="{Binding Rate}" VerticalAlignment="Center" Margin="8,0" />
      </StackPanel>
      <TextBlock DockPanel.Dock="Top" Classes="error" Text="{Binding Error}" IsVisible="{Binding HasError}" Margin="0,0,0,8" />
      <ScrollViewer>
        <ItemsControl ItemsSource="{Binding Selected}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:LiveParameterViewModel">
              <Border Classes="card" Width="250" Margin="0,0,12,12">
                <StackPanel Spacing="6">
                  <TextBlock Classes="muted" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="{Binding Value}" FontSize="28" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Unit}" Classes="muted" VerticalAlignment="Bottom" Margin="0,0,0,5" />
                  </StackPanel>
                  <c:Sparkline Values="{Binding Points}" Height="36" Stroke="{DynamicResource ChartBrush}" />
                  <TextBlock Classes="muted" FontSize="11" Text="{Binding Range}" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </DockPanel>
  </Grid>
</UserControl>
