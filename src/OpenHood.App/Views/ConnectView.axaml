<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OpenHood.App.ViewModels"
             xmlns:data="using:OpenHood.Data"
             xmlns:serial="using:OpenHood.Serial"
             x:Class="OpenHood.App.Views.ConnectView"
             x:DataType="vm:ConnectViewModel">
  <ScrollViewer>
    <StackPanel Margin="32,28" Spacing="20" MaxWidth="760" HorizontalAlignment="Left">
      <StackPanel Spacing="4">
        <TextBlock Classes="h1" Text="Connect to your car" />
        <TextBlock Classes="muted" Text="Plug the K+DCAN cable into the OBD port under the dashboard, then choose your car." TextWrapping="Wrap" />
      </StackPanel>

      <!-- Vehicle -->
      <Border Classes="card">
        <StackPanel Spacing="10">
          <TextBlock Classes="h2" Text="Vehicle" />
          <ComboBox ItemsSource="{Binding Vehicles}" SelectedItem="{Binding Vehicle}" MinWidth="360">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="data:VehicleFamily">
                <TextBlock Text="{Binding Name}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <Border Classes="chip" HorizontalAlignment="Left">
            <TextBlock Text="{Binding CableHint}" TextWrapping="Wrap" FontSize="13" />
          </Border>
        </StackPanel>
      </Border>

      <!-- Cable -->
      <Border Classes="card">
        <StackPanel Spacing="10">
          <TextBlock Classes="h2" Text="Cable" />
          <CheckBox IsChecked="{Binding UseDemo}" Content="Demo car (no cable needed: try OpenHood on a simulated E46 or E90)" />
          <StackPanel Orientation="Horizontal" Spacing="8" IsEnabled="{Binding !UseDemo}">
            <ComboBox ItemsSource="{Binding Ports}" SelectedItem="{Binding Port}" MinWidth="300" PlaceholderText="No serial ports found">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="serial:PortInfo">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Description}" Classes="muted" />
                    <TextBlock Text="K+DCAN" Foreground="{DynamicResource OkBrush}" IsVisible="{Binding LikelyKDCan}" />
                  </StackPanel>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <Button Content="Refresh" Command="{Binding RefreshPortsCommand}" />
          </StackPanel>
          <CheckBox IsChecked="{Binding TrustDsr}" IsEnabled="{Binding !UseDemo}"
                    Content="My cable reports ignition on DSR (stop me if the ignition is off)" />
        </StackPanel>
      </Border>

      <!-- Data source -->
      <Border Classes="card">
        <StackPanel Spacing="10">
          <TextBlock Classes="h2" Text="Data source" />
          <TextBlock Classes="muted" TextWrapping="Wrap"
                     Text="OpenHood's own protocol stack works out of the box. For full coverage you can also use the SGBD files from your own EDIABAS/INPA install." />
          <CheckBox IsChecked="{Binding UseEdiabas}" IsEnabled="{Binding EdiabasAvailable}" Content="Use my EDIABAS files" />
          <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding UseEdiabas}">
            <TextBox Text="{Binding EdiabasPath}" Watermark="C:\EDIABAS\Ecu" MinWidth="360" />
            <Button Content="Browse..." Command="{Binding BrowseEdiabasCommand}" />
          </StackPanel>
          <TextBlock Classes="muted" FontSize="12" Text="{Binding EdiabasNote}" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <!-- Actions -->
      <StackPanel Orientation="Horizontal" Spacing="10">
        <Button Classes="accent" Content="Connect" Command="{Binding ConnectCommand}" Padding="22,10" />
        <Button Content="Disconnect" Command="{Binding DisconnectCommand}" Padding="16,10" IsVisible="{Binding IsConnected}" />
        <TextBlock Text="{Binding Ignition}" Foreground="{Binding IgnitionBrush}" VerticalAlignment="Center" Margin="8,0" />
      </StackPanel>
      <TextBlock Text="{Binding Session.Status}" Classes="muted" />
      <TextBlock Classes="error" Text="{Binding Error}" IsVisible="{Binding HasError}" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
