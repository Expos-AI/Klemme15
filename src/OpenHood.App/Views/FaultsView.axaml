<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OpenHood.App.ViewModels"
             x:Class="OpenHood.App.Views.FaultsView"
             x:DataType="vm:FaultsViewModel">
  <DockPanel Margin="36,26,36,0">
    <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,18">
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="Read again" Command="{Binding RefreshCommand}" VerticalAlignment="Center" />
        <TextBlock Classes="title" Text="Faults" />
      </DockPanel>
      <TextBlock Text="{Binding Headline}" Classes="muted" FontSize="16" IsVisible="{Binding !IsEmpty}" />
      <TextBlock Classes="error" Text="{Binding Error}" IsVisible="{Binding HasError}" />
      <TextBlock Classes="muted" Text="{Binding EmptyText}" IsVisible="{Binding IsEmpty}" TextWrapping="Wrap" MaxWidth="560" HorizontalAlignment="Left" />
    </StackPanel>

    <ScrollViewer>
      <ItemsControl ItemsSource="{Binding Groups}" Margin="0,0,0,32" MaxWidth="980" HorizontalAlignment="Left">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:FaultGroupViewModel">
            <StackPanel Spacing="4" Margin="0,0,0,26">
              <!-- module header -->
              <DockPanel Margin="0,0,0,6">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                  <Button Classes="quiet" Content="Clear fault memory" Command="{Binding AskClearCommand}" IsVisible="{Binding NotConfirming}" />
                  <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding Confirming}">
                    <TextBlock Text="Clear every fault in this module?" VerticalAlignment="Center" />
                    <Button Classes="primary" Content="Clear" Command="{Binding ClearCommand}" Padding="14,6" />
                    <Button Content="Keep" Command="{Binding CancelClearCommand}" Padding="12,6" />
                  </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="12">
                  <TextBlock Classes="section" Text="{Binding Name}" />
                  <TextBlock Classes="muted small" Text="{Binding Address}" VerticalAlignment="Center" />
                  <TextBlock Classes="muted small" Text="{Binding CountText}" VerticalAlignment="Center" />
                </StackPanel>
              </DockPanel>
              <TextBlock Classes="muted" Text="{Binding Message}" IsVisible="{Binding HasMessage}" TextWrapping="Wrap" Margin="0,0,0,6" />

              <ItemsControl ItemsSource="{Binding Faults}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:FaultItemViewModel">
                    <Border Classes="panel" Padding="0" Margin="0,0,0,8">
                      <Grid ColumnDefinitions="4,110,*,Auto">
                        <Border Classes="faultbar" Classes.active="{Binding IsActive}" CornerRadius="6,0,0,6" />
                        <StackPanel Grid.Column="1" Margin="18,14,8,14" Spacing="6">
                          <SelectableTextBlock Classes="code" Text="{Binding Code}" />
                          <Border Classes="statechip" Classes.active="{Binding IsActive}" HorizontalAlignment="Left">
                            <TextBlock Text="{Binding StateText}" />
                          </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="8,14,12,14" Spacing="6">
                          <SelectableTextBlock Text="{Binding Description}" TextWrapping="Wrap" FontSize="15" />
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Classes="muted small" Text="Check here:" />
                            <TextBlock Classes="small" Text="{Binding Where}" TextWrapping="Wrap" />
                          </StackPanel>
                          <TextBlock Classes="muted small" Text="{Binding Details}" TextWrapping="Wrap" IsVisible="{Binding HasDetails}" />
                        </StackPanel>
                        <Button Grid.Column="3" Classes="quiet" Content="Show on car" Command="{Binding ShowCommand}" VerticalAlignment="Center" Margin="0,0,14,0" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </DockPanel>
</UserControl>
