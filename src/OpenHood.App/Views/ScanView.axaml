<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OpenHood.App.ViewModels"
             x:Class="OpenHood.App.Views.ScanView"
             x:DataType="vm:ScanViewModel">
  <DockPanel Margin="32,28">
    <StackPanel DockPanel.Dock="Top" Spacing="16">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button Content="Cancel" Command="{Binding CancelCommand}" IsVisible="{Binding IsScanning}" />
          <Button Classes="accent" Content="Run quick test" Command="{Binding RunCommand}" Padding="18,9" />
        </StackPanel>
        <StackPanel Spacing="4">
          <TextBlock Classes="h1" Text="Quick test" />
          <TextBlock Classes="muted" Text="Identifies every module and reads its fault memory." />
        </StackPanel>
      </DockPanel>

      <TextBlock Classes="muted" Text="Connect to a car first (Connect page)." IsVisible="{Binding NotConnected}" />

      <StackPanel Spacing="6" IsVisible="{Binding IsScanning}">
        <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="100" Height="6" />
        <TextBlock Classes="muted" Text="{Binding ProgressText}" />
      </StackPanel>

      <!-- Summary -->
      <WrapPanel IsVisible="{Binding HasResult}">
        <Border Classes="card" Margin="0,0,12,12" MinWidth="160">
          <StackPanel><TextBlock Text="{Binding ModulesSummary}" FontSize="22" FontWeight="SemiBold" /><TextBlock Classes="muted" Text="modules answered" /></StackPanel>
        </Border>
        <Border Classes="card" Margin="0,0,12,12" MinWidth="160">
          <StackPanel><TextBlock Text="{Binding FaultSummary}" FontSize="22" FontWeight="SemiBold" /><TextBlock Classes="muted" Text="faults" /></StackPanel>
        </Border>
        <Border Classes="card" Margin="0,0,12,12" MinWidth="160">
          <StackPanel><TextBlock Text="{Binding TimeSummary}" FontSize="22" FontWeight="SemiBold" /><TextBlock Classes="muted" Text="scan time" /></StackPanel>
        </Border>
        <Border Classes="card" Margin="0,0,12,12" MinWidth="220">
          <StackPanel><SelectableTextBlock Classes="mono" Text="{Binding Vin}" FontSize="18" FontWeight="SemiBold" /><TextBlock Classes="muted" Text="VIN" /></StackPanel>
        </Border>
      </WrapPanel>

      <DockPanel IsVisible="{Binding HasResult}">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
          <Button Content="View faults" Command="{Binding ShowFaultsCommand}" />
          <Button Content="Save report (HTML)" Command="{Binding ExportHtmlCommand}" />
          <Button Content="Markdown" Command="{Binding ExportMarkdownCommand}" />
          <Button Content="JSON" Command="{Binding ExportJsonCommand}" />
        </StackPanel>
        <CheckBox IsChecked="{Binding ShowAbsent}" Content="Show modules that did not answer" />
      </DockPanel>
      <TextBlock Classes="error" Text="{Binding Error}" IsVisible="{Binding HasError}" />
    </StackPanel>

    <Border Classes="card" Margin="0,12,0,0" Padding="12,4">
      <ScrollViewer>
        <ItemsControl ItemsSource="{Binding VisibleRows}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:EcuRowViewModel">
              <Border Classes="row">
                <Grid ColumnDefinitions="16,260,70,170,*">
                  <Ellipse Width="10" Height="10" Fill="{Binding StatusBrush}" VerticalAlignment="Center" />
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Text="unverified" Classes="muted" FontSize="11" VerticalAlignment="Center" IsVisible="{Binding Unverified}"
                               ToolTip.Tip="This module entry has not been confirmed on a real car yet. Please report what you see." />
                  </StackPanel>
                  <TextBlock Grid.Column="2" Classes="mono muted" Text="{Binding Address}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="3" Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="4" Classes="muted" Text="{Binding Detail}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                             ToolTip.Tip="{Binding Detail}" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>
  </DockPanel>
</UserControl>
