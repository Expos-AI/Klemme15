<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="OpenHood.App.App"
             RequestedThemeVariant="Default">

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="WindowBrush" Color="#F4F4F1" />
          <SolidColorBrush x:Key="SidebarBrush" Color="#EAEAE6" />
          <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="LineBrush" Color="#E0E0DB" />
          <SolidColorBrush x:Key="MutedBrush" Color="#62666E" />
          <SolidColorBrush x:Key="OkBrush" Color="#1F8A4C" />
          <SolidColorBrush x:Key="WarnBrush" Color="#B86E00" />
          <SolidColorBrush x:Key="BadBrush" Color="#C0362C" />
          <SolidColorBrush x:Key="AccentSoftBrush" Color="#E3ECFA" />
          <SolidColorBrush x:Key="ChartBrush" Color="#2F6FDB" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="WindowBrush" Color="#141518" />
          <SolidColorBrush x:Key="SidebarBrush" Color="#1A1C20" />
          <SolidColorBrush x:Key="CardBrush" Color="#202227" />
          <SolidColorBrush x:Key="LineBrush" Color="#30333A" />
          <SolidColorBrush x:Key="MutedBrush" Color="#9AA0A8" />
          <SolidColorBrush x:Key="OkBrush" Color="#4CC27F" />
          <SolidColorBrush x:Key="WarnBrush" Color="#F0A43A" />
          <SolidColorBrush x:Key="BadBrush" Color="#F06A5F" />
          <SolidColorBrush x:Key="AccentSoftBrush" Color="#1E2A3D" />
          <SolidColorBrush x:Key="ChartBrush" Color="#6EA8FF" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />

    <Style Selector="TextBlock.h1">
      <Setter Property="FontSize" Value="24" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.h2">
      <Setter Property="FontSize" Value="16" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.muted, SelectableTextBlock.muted">
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
    </Style>
    <Style Selector="TextBlock.mono, SelectableTextBlock.mono, TextBox.mono">
      <Setter Property="FontFamily" Value="Cascadia Mono,Consolas,Menlo,DejaVu Sans Mono,monospace" />
    </Style>
    <Style Selector="TextBlock.error">
      <Setter Property="Foreground" Value="{DynamicResource BadBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource CardBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="16" />
    </Style>
    <Style Selector="Border.row">
      <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="Padding" Value="4,10" />
    </Style>
    <Style Selector="Border.chip">
      <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="10,4" />
    </Style>
    <Style Selector="ListBox.nav">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.nav ListBoxItem">
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Margin" Value="0,2" />
      <Setter Property="Padding" Value="12,10" />
    </Style>
  </Application.Styles>
</Application>
