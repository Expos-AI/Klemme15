<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Klemme15.Data</RootNamespace>
    <Description>The open, community-written vehicle database (modules, fault code texts, live parameters).</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Klemme15.Core\Klemme15.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="db\**\*.json" LogicalName="Klemme15.Data.%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
