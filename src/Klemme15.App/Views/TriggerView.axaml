<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Klemme15.App.ViewModels"
             xmlns:gh="using:Klemme15.Core.GhostHunter"
             x:Class="Klemme15.App.Views.TriggerView"
             x:DataType="vm:TriggerViewModel">
  <UserControl.Styles>
    <Style Selector="Border.card">
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="14,10" />
      <Setter Property="Background" Value="{DynamicResource RaisedBrush}" />
    </Style>
  </UserControl.Styles>

  <Grid ColumnDefinitions="*,*" Margin="36,26,36,0">
    <!-- Left: rules and the builder -->
    <ScrollViewer Classes="page" Grid.Column="0" Margin="0,0,18,0">
      <StackPanel Spacing="14" Margin="0,0,12,32">
        <TextBlock Classes="title" Text="Ghost Hunter" />
        <TextBlock Classes="muted" TextWrapping="Wrap"
                   Text="For a problem that comes and goes and is never there when you look. Klemme15 reads the engine computer a few times a second while you drive, and the moment the problem shows up it saves the minute before and the minute after, so you can see what led to it. Read-only: nothing is sent to the car." />
        <Border Classes="card">
          <StackPanel Spacing="4">
            <TextBlock Text="1. Tick what you're chasing below. Each one says how to catch it." TextWrapping="Wrap" />
            <TextBlock Text="2. Press Start watching, leave the laptop running and plugged in, and drive the way the problem usually happens. Most need the engine warm or the car moving: the Right now list says what each one is waiting for." TextWrapping="Wrap" />
            <TextBlock Text="3. When it happens, a capture appears on the right by itself. Stop when you park and open the capture to see what the engine did around that moment." TextWrapping="Wrap" />
          </StackPanel>
        </Border>
        <DockPanel>
          <Button DockPanel.Dock="Right" Classes="quiet" Content="Check again" Command="{Binding ProbeCommand}" VerticalAlignment="Center" />
          <TextBlock Classes="muted small" Text="{Binding SignalsText}" TextWrapping="Wrap" VerticalAlignment="Center" />
        </DockPanel>

        <TextBlock Classes="section" FontSize="16" Text="Watch for" />
        <ItemsControl ItemsSource="{Binding Rules}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:RuleItem">
              <Border Classes="card" Margin="0,0,0,8">
                <DockPanel>
                  <Button DockPanel.Dock="Right" Classes="quiet" Content="Delete" Command="{Binding DeleteCommand}" IsVisible="{Binding CanDelete}" VerticalAlignment="Center" />
                  <CheckBox IsChecked="{Binding IsArmed}" IsEnabled="{Binding IsAvailable}" VerticalAlignment="Top">
                    <StackPanel Spacing="2">
                      <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                      <TextBlock Classes="small" Text="{Binding WhenToUse}" TextWrapping="Wrap" IsVisible="{Binding HasWhenToUse}" />
                      <TextBlock Classes="small" Text="{Binding DriveTip}" TextWrapping="Wrap" IsVisible="{Binding HasDriveTip}" />
                      <TextBlock Classes="muted small" Text="{Binding Describe}" TextWrapping="Wrap" />
                      <TextBlock Classes="small" Foreground="{DynamicResource AmberBrush}" Text="{Binding Unavailable}" TextWrapping="Wrap" IsVisible="{Binding HasUnavailable}" />
                    </StackPanel>
                  </CheckBox>
                </DockPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border Classes="panel" Padding="18,14">
          <StackPanel Spacing="10">
            <TextBlock Classes="section" FontSize="16" Text="Make your own rule" />
            <TextBlock Classes="muted small" TextWrapping="Wrap" Text="Start from a template and adjust it, or build one from scratch." />
            <ComboBox ItemsSource="{Binding Templates}" SelectedItem="{Binding SelectedTemplate}" PlaceholderText="Start from a template..."
                      HorizontalAlignment="Stretch">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="gh:TriggerTemplate">
                  <StackPanel Spacing="1" Margin="0,2">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                    <TextBlock Classes="muted small" Text="{Binding WhenToUse}" TextWrapping="Wrap" MaxWidth="520" />
                  </StackPanel>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <Border Background="{DynamicResource LitSoftBrush}" CornerRadius="6" Padding="10,8" IsVisible="{Binding HasTemplateHint}">
              <TextBlock Text="{Binding TemplateHint}" TextWrapping="Wrap" />
            </Border>
            <TextBox Watermark="Name, e.g. Stumble when warm" Text="{Binding NewTitle}" />
            <TextBlock Classes="muted small" Text="All of these at once:" />
            <ItemsControl ItemsSource="{Binding NewConditions}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ConditionRow">
                  <!-- Two lines, so long value names ("Short-term trim, leaner bank") are never cut off. -->
                  <Grid ColumnDefinitions="1.3*,90,Auto,70,Auto,Auto" RowDefinitions="Auto,Auto" Margin="0,0,0,12">
                    <ComboBox Grid.Row="0" Grid.ColumnSpan="6" ItemsSource="{Binding Signals}"
                              SelectedItem="{Binding Signal}" HorizontalAlignment="Stretch" PlaceholderText="Value" Margin="0,0,0,6" />
                    <ComboBox Grid.Row="1" Grid.Column="0" ItemsSource="{Binding Operators}"
                              SelectedItem="{Binding Operator}" HorizontalAlignment="Stretch" Margin="0,0,6,0" />
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Threshold}" Watermark="value" />
                    <TextBlock Grid.Row="1" Grid.Column="2" Classes="muted small" Text="for" VerticalAlignment="Center" Margin="8,0" />
                    <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding Hold}" Watermark="s" />
                    <TextBlock Grid.Row="1" Grid.Column="4" Classes="muted small" Text="s" VerticalAlignment="Center" Margin="6,0" />
                    <Button Grid.Row="1" Grid.Column="5" Classes="quiet" Content="Remove" Command="{Binding RemoveCommand}" VerticalAlignment="Center" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Classes="quiet" Content="Add a condition" Command="{Binding AddConditionCommand}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Classes="muted small" Text="Keep" VerticalAlignment="Center" />
              <TextBox Text="{Binding Before}" Width="60" />
              <TextBlock Classes="muted small" Text="s before and" VerticalAlignment="Center" />
              <TextBox Text="{Binding After}" Width="60" />
              <TextBlock Classes="muted small" Text="s after" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Classes="small" Foreground="{DynamicResource RedBrush}" Text="{Binding BuilderError}" TextWrapping="Wrap" IsVisible="{Binding HasBuilderError}" />
            <Button Classes="primary" Content="Save rule" Command="{Binding SaveRuleCommand}" HorizontalAlignment="Left" />
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <!-- Right: start, status, captures -->
    <ScrollViewer Classes="page" Grid.Column="1" Margin="18,0,0,0">
      <StackPanel Spacing="14" Margin="0,0,0,32">
        <Border Classes="panel" Padding="22,20">
          <StackPanel Spacing="12">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Button Classes="primary" Content="Start watching" Command="{Binding StartCommand}" FontSize="16" Padding="22,10" IsVisible="{Binding NotWatching}" />
              <Button Content="Stop" Command="{Binding StopCommand}" FontSize="16" Padding="22,10" IsVisible="{Binding IsWatching}" />
            </StackPanel>
            <TextBlock Text="{Binding Status}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Classes="muted small" Text="{Binding StartHint}" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
        <Border Padding="18,14" CornerRadius="8" Background="{DynamicResource AmberSoftBrush}" BorderBrush="{DynamicResource AmberBrush}" BorderThickness="1"
                IsVisible="{Binding HasBanner}">
          <TextBlock Text="{Binding Banner}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
        </Border>

        <StackPanel Spacing="8" IsVisible="{Binding HasRightNow}">
          <TextBlock Classes="section" FontSize="16" Text="Right now" />
          <ItemsControl ItemsSource="{Binding RightNow}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:RightNowItem">
                <Border Classes="card" Margin="0,0,0,6">
                  <StackPanel Spacing="2">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Classes="small" Text="{Binding Text}" TextWrapping="Wrap"
                               Foreground="{DynamicResource MutedBrush}" IsVisible="{Binding IsWaiting}" />
                    <TextBlock Classes="small" Text="{Binding Text}" TextWrapping="Wrap" IsVisible="{Binding IsReady}" />
                    <TextBlock Classes="small" Text="{Binding Text}" TextWrapping="Wrap" FontWeight="SemiBold"
                               Foreground="{DynamicResource AmberBrush}" IsVisible="{Binding IsHolding}" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <TextBlock Classes="section" FontSize="16" Text="Captures" />
        <TextBlock Classes="muted small" TextWrapping="Wrap" IsVisible="{Binding !HasCaptures}"
                   Text="Nothing caught yet. Each capture is a snapshot on this computer: open it to see the car's modules, faults and the live data around the moment on the Analyse page, or share it on a forum." />
        <ItemsControl ItemsSource="{Binding Captures}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:CaptureItem">
              <Border Classes="card" Margin="0,0,0,8">
                <DockPanel>
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Button Content="Open" Command="{Binding OpenCommand}" />
                    <Button Classes="quiet" Content="Delete" Command="{Binding DeleteCommand}" />
                  </StackPanel>
                  <StackPanel Spacing="2">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Classes="muted small" Text="{Binding When}" />
                  </StackPanel>
                </DockPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
