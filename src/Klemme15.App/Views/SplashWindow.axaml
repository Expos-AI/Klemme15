    <!-- loading line + bar, lined up with the wordmark column of the lockup -->
    <Grid x:Name="LoadPanel" Opacity="0" Margin="0,22,0,0"
          ColumnDefinitions="32.76*,65.22*,2.02*" RowDefinitions="Auto,Auto"
          TextElement.FontFamily="Cascadia Mono,Consolas,Menlo,DejaVu Sans Mono"
          TextElement.FontSize="12">
      <Grid.Transitions>
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.35" />
        </Transitions>
      </Grid.Transitions>
      <Grid Grid.Column="1" ColumnDefinitions="*,Auto">
        <TextBlock x:Name="Status" Foreground="#7F8A98" />
        <TextBlock x:Name="Percent" Grid.Column="1" Foreground="#5F6977" Text="0%" />
      </Grid>
      <Border x:Name="Track" Grid.Column="1" Grid.Row="1" Height="2" Margin="0,10,0,0"
              Background="#1B212A" CornerRadius="1" ClipToBounds="True">
        <Border x:Name="BarFill" HorizontalAlignment="Left" Width="0" Background="#F2A93B">
          <Border.Transitions>
            <Transitions>
              <DoubleTransition Property="Width" Duration="0:0:0.35" />
            </Transitions>
          </Border.Transitions>
        </Border>
      </Border>
    </Grid>

  </StackPanel>
</Window>
