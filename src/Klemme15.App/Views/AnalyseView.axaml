<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Klemme15.App.ViewModels"
             xmlns:c="using:Klemme15.App.Controls"
             x:Class="Klemme15.App.Views.AnalyseView"
             x:DataType="vm:AnalyseViewModel">
  <DockPanel Margin="36,26,36,0">
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <TextBlock Classes="muted small" Text="{Binding FileTitle}" VerticalAlignment="Center" Margin="0,0,8,0" IsVisible="{Binding HasFile}" />
        <Button Classes="primary" Content="Open a datalog..." Command="{Binding OpenCommand}" />
      </StackPanel>
      <StackPanel>
        <TextBlock Classes="title" Text="Analyse" />
        <TextBlock Classes="muted small" Text="Scatter plots, a tuning-style map and synchronized playback of a recorded CSV. Nothing is sent to the car." />
      </StackPanel>
    </DockPanel>

    <TextBlock Classes="muted" Text="{Binding Status}" TextWrapping="Wrap" IsVisible="{Binding NoData}" VerticalAlignment="Top" />

    <ScrollViewer IsVisible="{Binding HasData}">
      <StackPanel Spacing="16" Margin="0,0,0,32">
        <!-- Playback -->
        <Border Classes="panel" Padding="18,14">
          <StackPanel Spacing="10">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
              <Button Content="{Binding PlayLabel}" Command="{Binding PlayCommand}" Width="86" />
              <Button Content="{Binding SpeedLabel}" Command="{Binding CycleSpeedCommand}" Width="60" />
              <TextBlock Classes="mono" Text="{Binding PositionTime}" VerticalAlignment="Center" Width="70" />
              <Slider Minimum="0" Maximum="{Binding MaxPosition}" Value="{Binding Position}" Width="560" VerticalAlignment="Center" />
            </StackPanel>
            <ItemsControl ItemsSource="{Binding Readouts}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ChannelReadoutViewModel">
                  <Border Classes="panel" Padding="10,6" Margin="0,0,8,8" MinWidth="120">
                    <StackPanel>
                      <TextBlock Classes="muted small" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                      <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Classes="mono" FontSize="17" FontWeight="SemiBold" Text="{Binding Value}" />
                        <TextBlock Classes="muted small" Text="{Binding Unit}" VerticalAlignment="Bottom" Margin="0,0,0,2" />
                      </StackPanel>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <Grid ColumnDefinitions="*,*" >
          <!-- Scatter -->
          <Border Grid.Column="0" Classes="panel" Padding="18,14" Margin="0,0,8,0">
            <StackPanel Spacing="10">
              <TextBlock Classes="section" FontSize="16" Text="Scatter" />
              <StackPanel Orientation="Horizontal" Spacing="10">
                <StackPanel>
                  <TextBlock Classes="muted small" Text="Y (up)" />
                  <ComboBox ItemsSource="{Binding Channels}" SelectedItem="{Binding ScatterY}" MinWidth="180" />
                </StackPanel>
                <StackPanel>
                  <TextBlock Classes="muted small" Text="X (across)" />
                  <ComboBox ItemsSource="{Binding Channels}" SelectedItem="{Binding ScatterX}" MinWidth="180" />
                </StackPanel>
              </StackPanel>
              <Border Background="{DynamicResource RaisedBrush}" CornerRadius="6" Height="300">
                <c:ScatterPlot Points="{Binding ScatterPoints}" Highlight="{Binding Highlight}"
                               AxisBrush="{DynamicResource LineBrush}" Margin="8" />
              </Border>
              <TextBlock Classes="muted small" Text="{Binding ScatterCaption}" />
              <TextBlock Classes="muted small" Text="Points run blue (start) to orange (end), so drift over the log shows. The ringed point is where playback is." TextWrapping="Wrap" />
            </StackPanel>
          </Border>

          <!-- Map -->
          <Border Grid.Column="1" Classes="panel" Padding="18,14" Margin="8,0,0,0">
            <StackPanel Spacing="10">
              <TextBlock Classes="section" FontSize="16" Text="Map" />
              <StackPanel Orientation="Horizontal" Spacing="10">
                <StackPanel>
                  <TextBlock Classes="muted small" Text="Value" />
                  <ComboBox ItemsSource="{Binding Channels}" SelectedItem="{Binding MapValue}" MinWidth="150" />
                </StackPanel>
                <StackPanel>
                  <TextBlock Classes="muted small" Text="Up" />
                  <ComboBox ItemsSource="{Binding Channels}" SelectedItem="{Binding MapY}" MinWidth="120" />
                </StackPanel>
                <StackPanel>
                  <TextBlock Classes="muted small" Text="Across" />
                  <ComboBox ItemsSource="{Binding Channels}" SelectedItem="{Binding MapX}" MinWidth="120" />
                </StackPanel>
              </StackPanel>
              <Border Background="{DynamicResource RaisedBrush}" CornerRadius="6" Height="300">
                <c:BinMap Bins="{Binding MapBins}" Diverging="{Binding MapDiverging}"
                          GridBrush="{DynamicResource LineBrush}" TextBrush="{DynamicResource InkBrush}" Margin="8" />
              </Border>
              <TextBlock Classes="muted small" Text="{Binding MapCaption}" TextWrapping="Wrap" />
              <TextBlock Classes="muted small" Text="{Binding MapAxes}" />
            </StackPanel>
          </Border>
        </Grid>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
