<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Klemme15.App.ViewModels"
             xmlns:c="using:Klemme15.App.Controls"
             x:Class="Klemme15.App.Views.LiveView"
             x:DataType="vm:LiveViewModel">
  <UserControl.Styles>
    <Style Selector="ToggleButton.chip">
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Padding" Value="12,5" />
      <Setter Property="Margin" Value="0,0,8,8" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="ToggleButton.chip:checked /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource LitSoftBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource LitBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
    </Style>
  </UserControl.Styles>

  <DockPanel Margin="36,26,36,0">
    <StackPanel DockPanel.Dock="Top" Spacing="14" Margin="0,0,0,18">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <TextBlock Classes="muted small" Text="{Binding Rate}" VerticalAlignment="Center" Margin="0,0,8,0" />
          <TextBlock Classes="red small" Text="Recording" VerticalAlignment="Center" IsVisible="{Binding IsRecording}" Margin="0,0,4,0" />
          <Button Content="Record" Command="{Binding RecordCommand}" />
          <Button Content="Save recording" Command="{Binding SaveRecordingCommand}" />
          <Button Content="Analyse" Command="{Binding AnalyseCommand}" />
          <Button Content="Stop" Command="{Binding StopCommand}" />
          <Button Classes="primary" Content="Start" Command="{Binding StartCommand}" />
        </StackPanel>
        <TextBlock Classes="title" Text="Live data" />
      </DockPanel>
      <TextBlock Classes="muted" Text="{Binding EmptyText}" TextWrapping="Wrap" IsVisible="{Binding !HasParameters}" />
      <TextBlock Classes="error" Text="{Binding Error}" IsVisible="{Binding HasError}" />
      <ItemsControl ItemsSource="{Binding Parameters}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:LiveParameterViewModel">
            <ToggleButton Classes="chip" IsChecked="{Binding IsSelected}" Content="{Binding Name}" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>

    <ScrollViewer>
      <ItemsControl ItemsSource="{Binding Selected}" Margin="0,0,0,32">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:LiveParameterViewModel">
            <Border Classes="panel" Width="268" Margin="0,0,14,14" Padding="18,16">
              <StackPanel Spacing="4">
                <TextBlock Classes="muted" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Classes="figure" Text="{Binding Value}" />
                  <TextBlock Classes="muted" Text="{Binding Unit}" VerticalAlignment="Bottom" Margin="0,0,0,9" FontSize="15" />
                </StackPanel>
                <c:Sparkline Values="{Binding Points}" Height="38" Stroke="{DynamicResource LitBrush}" Margin="0,4,0,4" />
                <TextBlock Classes="muted small" Text="{Binding Range}" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </DockPanel>
</UserControl>
