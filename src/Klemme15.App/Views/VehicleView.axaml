<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Klemme15.App.ViewModels"
             xmlns:c="using:Klemme15.App.Controls"
             x:Class="Klemme15.App.Views.VehicleView"
             x:DataType="vm:VehicleViewModel">

  <UserControl.DataTemplates>
    <!-- A fault in the side panel -->
    <DataTemplate DataType="vm:FaultItemViewModel">
      <Button Classes="faultrow" Command="{Binding ShowCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
        <Grid ColumnDefinitions="4,*" Margin="0,2">
          <Border Classes="faultbar" Classes.active="{Binding IsActive}" />
          <StackPanel Grid.Column="1" Margin="12,0,0,0" Spacing="3">
            <DockPanel>
              <Border DockPanel.Dock="Right" Classes="statechip" Classes.active="{Binding IsActive}" VerticalAlignment="Center">
                <TextBlock Text="{Binding StateText}" />
              </Border>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Classes="code" Text="{Binding Code}" FontSize="19" />
                <TextBlock Classes="muted small" Text="{Binding ModuleName}" VerticalAlignment="Center" />
              </StackPanel>
            </DockPanel>
            <TextBlock Text="{Binding Description}" TextWrapping="Wrap" />
            <TextBlock Classes="small lit" TextWrapping="Wrap" IsVisible="{Binding HasTip}" Text="{Binding Tip}" />
            <TextBlock Classes="muted small" Text="{Binding Where}" TextWrapping="Wrap" />
            <TextBlock Classes="muted small" FontStyle="Italic" Text="{Binding Provenance}" IsVisible="{Binding HasProvenance}" TextWrapping="Wrap" />
          </StackPanel>
        </Grid>
      </Button>
    </DataTemplate>
  </UserControl.DataTemplates>

  <UserControl.Styles>
    <Style Selector="Button.faultrow">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="10,10" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="FontWeight" Value="Normal" />
    </Style>
  </UserControl.Styles>

  <Grid ColumnDefinitions="*,380" RowDefinitions="Auto,*">

    <!-- Toolbar -->
    <Border Grid.ColumnSpan="2" Padding="28,16" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1">
      <DockPanel>
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="10">
          <Button Classes="primary" Content="Run quick test" Command="{Binding RunCommand}" />
          <Button Content="Stop" Command="{Binding CancelCommand}" IsVisible="{Binding IsScanning}" />
          <Button Classes="quiet" Content="Clear all faults" Command="{Binding AskClearAllCommand}" IsVisible="{Binding NotConfirmClearAll}" />
          <Button Classes="quiet" Content="Find other modules" Command="{Binding DiscoverCommand}"
                  ToolTip.Tip="Asks every address the database doesn't list (read-only). Takes about half a minute." />
        </StackPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4" IsVisible="{Binding HasScan}">
          <TextBlock Classes="muted small" Text="Save report" VerticalAlignment="Center" Margin="0,0,4,0" />
          <Button Classes="quiet" Content="HTML" Command="{Binding ExportHtmlCommand}" />
          <Button Classes="quiet" Content="Markdown" Command="{Binding ExportMarkdownCommand}" />
          <Button Classes="quiet" Content="JSON" Command="{Binding ExportJsonCommand}" />
          <Button Classes="quiet" Content="Copy for a forum post" Command="{Binding CopyForumCommand}"
                  ToolTip.Tip="A short summary with the VIN removed, ready to paste into E90Post, Reddit or Bimmerforums" />
          <TextBlock Classes="muted small" Text="{Binding CopiedText}" VerticalAlignment="Center" Margin="6,0,0,0" />
        </StackPanel>
        <StackPanel Margin="18,0" VerticalAlignment="Center" Spacing="5">
          <TextBlock Text="{Binding Summary}" IsVisible="{Binding HasScan}" />
          <TextBlock Text="{Binding ProgressText}" Classes="muted" IsVisible="{Binding IsScanning}" />
          <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="100" Height="3" MinHeight="3" IsVisible="{Binding IsScanning}" MaxWidth="360" HorizontalAlignment="Left" />
          <TextBlock Classes="muted" Text="Connect a car in the garage first." IsVisible="{Binding NotConnected}" />
          <TextBlock Classes="muted" Text="Run a quick test to ask every module for its faults." IsVisible="{Binding BeforeScan}" />
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- The car, centred with its legend directly underneath -->
    <StackPanel Grid.Row="1" VerticalAlignment="Center" Spacing="14" Margin="28,20,24,20">
      <Border Classes="panel" Background="{DynamicResource AmberSoftBrush}" BorderBrush="{DynamicResource AmberBrush}" Padding="14,10" IsVisible="{Binding HasWarning}">
        <TextBlock Text="{Binding Warning}" TextWrapping="Wrap" />
      </Border>
      <Border Classes="panel" Background="{DynamicResource AmberSoftBrush}" BorderBrush="{DynamicResource AmberBrush}" Padding="14,10" IsVisible="{Binding FrmFragile}">
        <TextBlock Text="{Binding FrmNotice}" TextWrapping="Wrap" FontWeight="SemiBold" />
      </Border>
      <Border Classes="panel" Padding="14,10" IsVisible="{Binding FrmSafe}">
        <TextBlock Classes="muted" Text="{Binding FrmNotice}" TextWrapping="Wrap" />
      </Border>
      <Border Classes="panel" Padding="14,10" IsVisible="{Binding ConfirmClearAll}">
        <DockPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" Margin="12,0,0,0">
            <Button Classes="primary" Content="Clear all" Command="{Binding ClearAllCommand}" Padding="14,6" />
            <Button Content="Keep" Command="{Binding CancelClearAllCommand}" Padding="12,6" />
          </StackPanel>
          <TextBlock Text="{Binding ClearAllQuestion}" TextWrapping="Wrap" VerticalAlignment="Center" />
        </DockPanel>
      </Border>
      <Viewbox Stretch="Uniform">
        <Grid Width="1000" Height="460">
          <c:CarDrawing />
          <ItemsControl Classes="markers" ItemsSource="{Binding Markers}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><Canvas Width="1000" Height="460" ClipToBounds="False" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.Styles>
              <Style Selector="ItemsControl.markers > ContentPresenter" x:DataType="vm:MarkerViewModel">
                <Setter Property="ClipToBounds" Value="False" />
                <Setter Property="Canvas.Left" Value="{Binding Left}" />
                <Setter Property="Canvas.Top" Value="{Binding Top}" />
              </Style>
            </ItemsControl.Styles>
          </ItemsControl>
        </Grid>
      </Viewbox>

      <WrapPanel HorizontalAlignment="Center">
        <StackPanel Orientation="Horizontal" Spacing="7" Margin="0,0,22,4">
          <Border Width="11" Height="11" CornerRadius="3" Background="{DynamicResource LitBrush}" VerticalAlignment="Center" />
          <TextBlock Classes="muted small" Text="Module answered" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="7" Margin="0,0,22,4">
          <Border Width="11" Height="11" CornerRadius="3" BorderThickness="1.5" BorderBrush="{DynamicResource SteelFaintBrush}" VerticalAlignment="Center" />
          <TextBlock Classes="muted small" Text="No answer" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="7" Margin="0,0,22,4">
          <Ellipse Width="11" Height="11" Fill="{DynamicResource AmberBrush}" VerticalAlignment="Center" />
          <TextBlock Classes="muted small" Text="Stored fault" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="7" Margin="0,0,22,4">
          <Ellipse Width="11" Height="11" Fill="{DynamicResource RedBrush}" VerticalAlignment="Center" />
          <TextBlock Classes="muted small" Text="Fault active now" />
        </StackPanel>
        <TextBlock Classes="muted small" Text="Locations are approximate. Click a marker for details." Margin="0,0,0,4" />
      </WrapPanel>
    </StackPanel>

    <!-- Side panel -->
    <Border Grid.Row="1" Grid.Column="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1,0,0,0">
      <Grid>
        <!-- Nothing selected: all faults -->
        <DockPanel IsVisible="{Binding NoSelection}" Margin="18,20,18,0">
          <Border DockPanel.Dock="Top" Classes="panel" Background="{DynamicResource RaisedBrush}" Padding="12,10" Margin="0,0,0,16" IsVisible="{Binding HasDiscovery}">
            <SelectableTextBlock Text="{Binding Discovery}" TextWrapping="Wrap" FontSize="13" LineHeight="19" />
          </Border>
          <!-- Dash (Check Control) messages: why the triangle is lit, even with no fault codes -->
          <Border DockPanel.Dock="Top" Classes="panel" Padding="12,10" Margin="0,0,0,16" IsVisible="{Binding HasDashMessages}"
                  Background="{DynamicResource RaisedBrush}">
            <StackPanel Spacing="8">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Path Data="M 9,1 L 17,16 L 1,16 Z" Width="18" Height="17" Fill="{DynamicResource RedBrush}" IsVisible="{Binding DashRed}" VerticalAlignment="Center" />
                <Path Data="M 9,1 L 17,16 L 1,16 Z" Width="18" Height="17" Fill="{DynamicResource AmberBrush}" IsVisible="{Binding DashYellow}" VerticalAlignment="Center" />
                <Path Data="M 9,1 L 17,16 L 1,16 Z" Width="18" Height="17" Stroke="{DynamicResource SteelFaintBrush}" StrokeThickness="1.5" IsVisible="{Binding DashNone}" VerticalAlignment="Center" />
                <TextBlock Classes="section" Text="{Binding DashHeading}" VerticalAlignment="Center" />
              </StackPanel>
              <TextBlock Classes="muted small" TextWrapping="Wrap" IsVisible="{Binding DashExplainsTriangle}"
                         Text="This is why the warning triangle is on. Dash messages aren't fault codes, so the fault memory can be empty." />
              <ScrollViewer MaxHeight="380" HorizontalScrollBarVisibility="Disabled">
              <ItemsControl ItemsSource="{Binding DashMessages}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="vm:CheckControlItem">
                    <StackPanel Spacing="2" Margin="0,4">
                      <Grid ColumnDefinitions="17,*,Auto">
                        <Ellipse Width="9" Height="9" Fill="{DynamicResource RedBrush}" IsVisible="{Binding IsRed}" VerticalAlignment="Top" Margin="0,6,0,0" HorizontalAlignment="Left" />
                        <Ellipse Width="9" Height="9" Fill="{DynamicResource AmberBrush}" IsVisible="{Binding IsYellow}" VerticalAlignment="Top" Margin="0,6,0,0" HorizontalAlignment="Left" />
                        <Ellipse Width="9" Height="9" Stroke="{DynamicResource SteelFaintBrush}" StrokeThickness="1.5" IsVisible="{Binding IsHistory}" VerticalAlignment="Top" Margin="0,6,0,0" HorizontalAlignment="Left" />
                        <TextBlock Grid.Column="1" Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" Margin="10,2,0,0" VerticalAlignment="Top">
                          <TextBlock Classes="code muted small" Text="{Binding Code}" />
                          <TextBlock Classes="muted small" Text="{Binding StateText}" />
                        </StackPanel>
                      </Grid>
                      <TextBlock Classes="muted small" Text="{Binding Description}" TextWrapping="Wrap" IsVisible="{Binding HasDescription}" Margin="17,0,0,0" />
                      <TextBlock Classes="muted small" Text="{Binding Hint}" TextWrapping="Wrap" IsVisible="{Binding HasHint}" Margin="17,0,0,0" />
                      <TextBlock Classes="muted small" Text="{Binding Official}" TextWrapping="Wrap" IsVisible="{Binding HasOfficial}" Margin="17,0,0,0" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              </ScrollViewer>
            </StackPanel>
          </Border>
          <TextBlock DockPanel.Dock="Top" Classes="muted small" TextWrapping="Wrap" Margin="6,0,0,10" Text="{Binding DashNote}" IsVisible="{Binding HasDashNote}" />
          <TextBlock DockPanel.Dock="Top" Classes="section" Text="Faults" Margin="6,0,0,10" />
          <TextBlock DockPanel.Dock="Top" Classes="error" Text="{Binding Error}" IsVisible="{Binding HasError}" Margin="6,0,0,10" />
          <TextBlock DockPanel.Dock="Top" Classes="muted" TextWrapping="Wrap" Margin="6,0"
                     IsVisible="{Binding !HasScan}"
                     Text="Faults appear here after a quick test, each pinned to the part of the car it points at." />
          <TextBlock DockPanel.Dock="Top" Classes="muted" TextWrapping="Wrap" Margin="6,0"
                     IsVisible="{Binding NoFaultsAfterScan}" Text="No faults stored in any module that answered." />
          <ScrollViewer>
            <ItemsControl ItemsSource="{Binding Faults}" Margin="0,0,0,16" />
          </ScrollViewer>
        </DockPanel>

        <!-- A marker selected -->
        <DockPanel IsVisible="{Binding HasSelection}" Margin="18,16,18,0">
          <Button DockPanel.Dock="Top" Classes="quiet" Content="All faults" Command="{Binding ClearSelectionCommand}" HorizontalAlignment="Left" Margin="0,0,0,10" />
          <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="6,0,6,12">
            <TextBlock Classes="muted small" Text="{Binding SelectedKind}" />
            <TextBlock Classes="section" FontSize="22" Text="{Binding SelectedTitle}" TextWrapping="Wrap" />
            <TextBlock Classes="muted" Text="{Binding SelectedInfo}" TextWrapping="Wrap" LineHeight="21" />
          </StackPanel>
          <ScrollViewer>
            <ItemsControl ItemsSource="{Binding SelectedFaults}" Margin="0,0,0,16" />
          </ScrollViewer>
        </DockPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>
