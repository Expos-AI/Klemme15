<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Klemme15.App.ViewModels"
             xmlns:core="using:Klemme15.Core.Coding"
             x:Class="Klemme15.App.Views.CodingView"
             x:DataType="vm:CodingViewModel">
  <UserControl.Styles>
    <Style Selector="Button.module">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="12,9" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="Button.module.selected">
      <Setter Property="Background" Value="{DynamicResource LitSoftBrush}" />
    </Style>
    <Style Selector="Border.card">
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="14,10" />
      <Setter Property="Background" Value="{DynamicResource RaisedBrush}" />
    </Style>
  </UserControl.Styles>

  <Grid ColumnDefinitions="300,*" Margin="36,26,36,0">
    <StackPanel Grid.Column="0" Margin="0,0,24,0" Spacing="10">
      <TextBlock Classes="title" Text="Coding" />
      <TextBlock Classes="muted small" TextWrapping="Wrap"
                 Text="Back up a module's coding before any coding tool touches it, put it back in one click, and switch popular comfort options. The key module (CAS), engine and safety modules are never coded." />
      <ItemsControl ItemsSource="{Binding Modules}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:CodingModuleItem">
            <Button Classes="module" Classes.selected="{Binding IsSelected}" Command="{Binding SelectCommand}">
              <StackPanel Spacing="2">
                <TextBlock Text="{Binding Name}" TextWrapping="Wrap" />
                <TextBlock Classes="muted small mono" Text="{Binding Detail}" />
              </StackPanel>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock Classes="muted small" TextWrapping="Wrap" IsVisible="{Binding NoModules}"
                 Text="Run the quick test: the comfort modules that answer it (footwell module, cluster, junction box...) appear here." />
    </StackPanel>

    <ScrollViewer Grid.Column="1">
      <StackPanel Spacing="14" MaxWidth="820" HorizontalAlignment="Left" Margin="0,4,0,32">
        <TextBlock Classes="muted" Text="{Binding Status}" TextWrapping="Wrap" />

        <StackPanel Spacing="14" IsVisible="{Binding HasModule}">
          <TextBlock Classes="section" Text="{Binding ModuleTitle}" />
          <Border Classes="panel" Background="{DynamicResource AmberSoftBrush}" BorderBrush="{DynamicResource AmberBrush}" Padding="14,10" IsVisible="{Binding HasFrmText}">
            <TextBlock Text="{Binding FrmText}" TextWrapping="Wrap" FontWeight="SemiBold" />
          </Border>

          <!-- Quick codes: guided setup -->
          <Border Classes="panel" Padding="18,14" IsVisible="{Binding HasSetupHeadline}" BorderBrush="{DynamicResource LitBrush}" BorderThickness="1">
            <StackPanel Spacing="8">
              <DockPanel>
                <Button DockPanel.Dock="Right" Classes="quiet" Content="Step-by-step guide" Command="{Binding OpenGuideCommand}" VerticalAlignment="Center" />
                <TextBlock FontWeight="SemiBold" Text="{Binding SetupHeadline}" TextWrapping="Wrap" VerticalAlignment="Center" />
              </DockPanel>
              <ItemsControl ItemsSource="{Binding SetupSteps}" IsVisible="{Binding ShowSetup}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:SetupStep">
                    <Grid ColumnDefinitions="22,*" Margin="0,3">
                      <Ellipse Width="11" Height="11" Fill="{DynamicResource LitBrush}" IsVisible="{Binding Done}" VerticalAlignment="Top" Margin="0,4,0,0" HorizontalAlignment="Left" />
                      <Ellipse Width="11" Height="11" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.5" IsVisible="{Binding NotDone}" VerticalAlignment="Top" Margin="0,4,0,0" HorizontalAlignment="Left" />
                      <StackPanel Grid.Column="1" Spacing="1">
                        <TextBlock Text="{Binding Title}" TextWrapping="Wrap" />
                        <TextBlock Classes="muted small" Text="{Binding Detail}" TextWrapping="Wrap" IsVisible="{Binding HasDetail}" />
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <WrapPanel IsVisible="{Binding ShowSetup}">
                <Button Classes="primary" Content="Verify with NCS Expert's latest reading" Command="{Binding VerifyLatestCommand}" Margin="0,0,8,6" />
                <Button Content="Share this map" Command="{Binding ShareCommand}" Margin="0,0,8,6"
                        ToolTip.Tip="Opens a pre-filled GitHub issue with this module's map, so the next owner of this module gets quick codes with no setup" />
              </WrapPanel>
              <TextBlock Classes="muted small" TextWrapping="Wrap" IsVisible="{Binding ShowSetup}"
                         Text="Klemme15 doesn't include BMW's software or coding data. If you don't have NCS Expert, teach Klemme15 below with any coding tool you already use. Workshops can get BMW's own software legally from BMW's aftersales portal." />
              <Button Classes="quiet" Content="BMW aftersales portal (official)" Command="{Binding OpenBmwCommand}" HorizontalAlignment="Left" IsVisible="{Binding ShowSetup}" />
            </StackPanel>
          </Border>

          <!-- Backups -->
          <Border Classes="panel" Padding="18,14">
            <StackPanel Spacing="10">
              <TextBlock FontWeight="SemiBold" Text="1. Back up" />
              <TextBlock Classes="muted small" TextWrapping="Wrap"
                         Text="Reads every coding block the module has and saves it on this computer. Works on any car, with no BMW data. Klemme15 also saves one automatically before every change it makes." />
              <StackPanel Orientation="Horizontal" Spacing="10">
                <Button Classes="primary" Content="Back up now" Command="{Binding BackupCommand}" />
                <Button Content="Read coding" Command="{Binding ReadCommand}" />
                <Button Content="Restore from a file..." Command="{Binding RestoreFileCommand}" />
              </StackPanel>
              <ItemsControl ItemsSource="{Binding Backups}" IsVisible="{Binding HasBackups}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:CodingBackupItem">
                    <Grid ColumnDefinitions="*,Auto" Margin="0,4">
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" />
                        <TextBlock Classes="muted small" Text="{Binding Detail}" />
                      </StackPanel>
                      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <Button Content="Compare with car" Command="{Binding CompareCommand}" />
                        <Button Content="Restore" Command="{Binding RestoreCommand}" />
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <SelectableTextBlock Classes="mono small" Text="{Binding Diff}" TextWrapping="Wrap" IsVisible="{Binding HasDiff}" />
            </StackPanel>
          </Border>

          <!-- NCS data and verification -->
          <Border Classes="panel" Padding="18,14">
            <StackPanel Spacing="10">
              <TextBlock FontWeight="SemiBold" Text="2. Settings by name (your NCS Expert data)" />
              <TextBlock Classes="muted small" Text="{Binding NcsStatus}" TextWrapping="Wrap" />
              <StackPanel Orientation="Horizontal" Spacing="10">
                <Button Content="Choose NCS data folder..." Command="{Binding ChooseNcsCommand}" />
                <Button Content="Verify with NCS Expert's trace file..." Command="{Binding VerifyCommand}" />
              </StackPanel>
              <TextBlock Classes="muted small" TextWrapping="Wrap"
                         Text="Writing unlocks only after verification: read this module once with NCS Expert, then pick the FSW_PSW.TRC it saved. Klemme15 must decode every setting exactly as NCS Expert did." />
              <TextBlock Text="{Binding Verification}" TextWrapping="Wrap" />
              <Button Content="Export this map to contribute..." Command="{Binding ExportCommand}" HorizontalAlignment="Left" />
              <Border Classes="panel" Background="{DynamicResource LitSoftBrush}" Padding="12,8" IsVisible="{Binding HasShared}">
                <TextBlock Text="{Binding SharedText}" TextWrapping="Wrap" />
              </Border>
            </StackPanel>
          </Border>

          <!-- One-click presets -->
          <Border Classes="panel" Padding="18,14" IsVisible="{Binding HasPresetLocked}">
            <StackPanel Spacing="6">
              <TextBlock FontWeight="SemiBold" Text="One-click presets" />
              <TextBlock Classes="muted small" Text="{Binding PresetLockedText}" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
          <StackPanel Spacing="8" IsVisible="{Binding HasPresets}">
            <TextBlock Classes="section" FontSize="16" Text="One-click presets" />
            <Border Classes="panel" Padding="14,10" IsVisible="{Binding PendingIsPreset}">
              <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" Margin="12,0,0,0">
                  <Button Classes="primary" Content="Code it" Command="{Binding ConfirmCommand}" Padding="14,6" />
                  <Button Content="Cancel" Command="{Binding CancelCommand}" Padding="12,6" />
                </StackPanel>
                <TextBlock Text="{Binding PendingText}" TextWrapping="Wrap" />
              </DockPanel>
            </Border>
            <ItemsControl ItemsSource="{Binding Presets}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:CodingToggleItem">
                  <Border Classes="card" Margin="0,0,0,8" BorderBrush="{DynamicResource LitBrush}" BorderThickness="1">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Spacing="3">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Description}" TextWrapping="Wrap" />
                        <TextBlock Classes="muted small" Text="{Binding IncludesText}" TextWrapping="Wrap" />
                        <TextBlock Classes="muted small" Text="{Binding Caveat}" TextWrapping="Wrap" IsVisible="{Binding HasCaveat}" />
                      </StackPanel>
                      <StackPanel Grid.Column="1" Spacing="6" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Classes="mono small" Text="{Binding StateText}" HorizontalAlignment="Right" />
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <Button Classes="primary" Content="{Binding OnLabel}" Command="{Binding TurnOnCommand}" IsEnabled="{Binding CanTurnOn}" />
                          <Button Content="{Binding OffLabel}" Command="{Binding TurnOffCommand}" IsEnabled="{Binding CanTurnOff}" />
                        </StackPanel>
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <!-- Teach from another coding tool -->
          <Border Classes="panel" Padding="18,14" IsVisible="{Binding CanLearn}">
            <StackPanel Spacing="8">
              <TextBlock FontWeight="SemiBold" Text="Teach Klemme15 from another coding tool" />
              <TextBlock Classes="muted small" TextWrapping="Wrap"
                         Text="Already use BimmerCode, NCS Expert or another tool? Klemme15 reads the module, you change one option with your tool, Klemme15 reads again and learns exactly which bits that option is on your module. From then on it works here, offline, with backup and read-back, and you can share it." />
              <WrapPanel>
                <ComboBox ItemsSource="{Binding LearnOptions}" SelectedItem="{Binding LearnOption}" PlaceholderText="Which option will you change?" MinWidth="300" MaxWidth="520" Margin="0,0,12,6">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="core:CodingToggle">
                      <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <RadioButton GroupName="learnDir" Content="I'll switch it on" IsChecked="{Binding LearnTurnedOn}" Margin="0,0,12,6" VerticalAlignment="Center" />
                <RadioButton GroupName="learnDir" Content="I'll switch it off" IsChecked="{Binding LearnTurnedOff}" Margin="0,0,12,6" VerticalAlignment="Center" />
              </WrapPanel>
              <WrapPanel>
                <Button Content="1. Read before" Command="{Binding LearnBeforeCommand}" Margin="0,0,8,6" />
                <Button Content="2. Read after" Command="{Binding LearnAfterCommand}" Margin="0,0,8,6" />
                <Button Classes="primary" Content="3. Save" Command="{Binding LearnSaveCommand}" Margin="0,0,8,6" />
              </WrapPanel>
              <TextBlock Text="{Binding LearnStatus}" TextWrapping="Wrap" />
              <SelectableTextBlock Classes="mono small" Text="{Binding LearnChanges}" TextWrapping="Wrap" IsVisible="{Binding HasLearnChanges}" />
            </StackPanel>
          </Border>

          <!-- Toggles -->
          <StackPanel Spacing="8" IsVisible="{Binding HasToggles}">
            <TextBlock Classes="section" FontSize="16" Text="3. Comfort options" />
            <TextBlock Classes="muted small" TextWrapping="Wrap" IsVisible="{Binding NotExperimental}"
                       Text="Coding is experimental: switch on experimental functions on the Service page to change these." />
            <Border Classes="panel" Padding="14,10" IsVisible="{Binding PendingIsToggle}">
              <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" Margin="12,0,0,0">
                  <Button Classes="primary" Content="Code it" Command="{Binding ConfirmCommand}" Padding="14,6" />
                  <Button Content="Cancel" Command="{Binding CancelCommand}" Padding="12,6" />
                </StackPanel>
                <TextBlock Text="{Binding PendingText}" TextWrapping="Wrap" />
              </DockPanel>
            </Border>
            <ItemsControl ItemsSource="{Binding Toggles}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:CodingToggleItem">
                  <Border Classes="card" Margin="0,0,0,8" IsVisible="{Binding Available}">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Spacing="3">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Description}" TextWrapping="Wrap" />
                        <TextBlock Classes="muted small" Text="{Binding Caveat}" TextWrapping="Wrap" IsVisible="{Binding HasCaveat}" />
                      </StackPanel>
                      <StackPanel Grid.Column="1" Spacing="6" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Classes="mono small" Text="{Binding StateText}" HorizontalAlignment="Right" />
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <Button Content="Turn on" Command="{Binding TurnOnCommand}" IsEnabled="{Binding CanTurnOn}" />
                          <Button Content="Turn off" Command="{Binding TurnOffCommand}" IsEnabled="{Binding CanTurnOff}" />
                        </StackPanel>
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <!-- All settings -->
          <StackPanel Spacing="8" IsVisible="{Binding HasSettings}">
            <TextBlock Classes="section" FontSize="16" Text="All settings (read-only)" />
            <TextBox Watermark="Filter by name" Text="{Binding Filter}" MaxWidth="320" HorizontalAlignment="Left" />
            <ItemsControl ItemsSource="{Binding Settings}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:CodingSettingItem">
                  <Grid ColumnDefinitions="360,160,*" Margin="0,2">
                    <TextBlock Classes="mono small" Text="{Binding Name}" />
                    <TextBlock Grid.Column="1" Classes="mono small" Text="{Binding Value}" />
                    <TextBlock Grid.Column="2" Classes="muted small" Text="{Binding Group}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
