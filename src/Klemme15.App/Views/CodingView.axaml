<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Klemme15.App.ViewModels"
             x:Class="Klemme15.App.Views.CodingView"
             x:DataType="vm:CodingViewModel">
  <UserControl.Styles>
    <Style Selector="Button.module">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="12,9" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="Button.module.selected">
      <Setter Property="Background" Value="{DynamicResource LitSoftBrush}" />
    </Style>
    <Style Selector="Border.card">
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="14,10" />
      <Setter Property="Background" Value="{DynamicResource RaisedBrush}" />
    </Style>
  </UserControl.Styles>

  <Grid ColumnDefinitions="300,*" Margin="36,26,36,0">
    <StackPanel Grid.Column="0" Margin="0,0,24,0" Spacing="10">
      <TextBlock Classes="title" Text="Coding" />
      <TextBlock Classes="muted small" TextWrapping="Wrap"
                 Text="Back up a module's coding before any coding tool touches it, put it back in one click, and switch popular comfort options. The key module (CAS), engine and safety modules are never coded." />
      <ItemsControl ItemsSource="{Binding Modules}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:CodingModuleItem">
            <Button Classes="module" Classes.selected="{Binding IsSelected}" Command="{Binding SelectCommand}">
              <StackPanel Spacing="2">
                <TextBlock Text="{Binding Name}" TextWrapping="Wrap" />
                <TextBlock Classes="muted small mono" Text="{Binding Detail}" />
              </StackPanel>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock Classes="muted small" TextWrapping="Wrap" IsVisible="{Binding NoModules}"
                 Text="Run the quick test: the comfort modules that answer it (footwell module, cluster, junction box...) appear here." />
    </StackPanel>

    <ScrollViewer Grid.Column="1">
      <StackPanel Spacing="14" MaxWidth="820" HorizontalAlignment="Left" Margin="0,4,0,32">
        <TextBlock Classes="muted" Text="{Binding Status}" TextWrapping="Wrap" />

        <StackPanel Spacing="14" IsVisible="{Binding HasModule}">
          <TextBlock Classes="section" Text="{Binding ModuleTitle}" />
          <Border Classes="panel" Background="{DynamicResource AmberSoftBrush}" BorderBrush="{DynamicResource AmberBrush}" Padding="14,10" IsVisible="{Binding HasFrmText}">
            <TextBlock Text="{Binding FrmText}" TextWrapping="Wrap" FontWeight="SemiBold" />
          </Border>

          <!-- Backups -->
          <Border Classes="panel" Padding="18,14">
            <StackPanel Spacing="10">
              <TextBlock FontWeight="SemiBold" Text="1. Back up" />
              <TextBlock Classes="muted small" TextWrapping="Wrap"
                         Text="Reads every coding block the module has and saves it on this computer. Works on any car, with no BMW data. Klemme15 also saves one automatically before every change it makes." />
              <StackPanel Orientation="Horizontal" Spacing="10">
                <Button Classes="primary" Content="Back up now" Command="{Binding BackupCommand}" />
                <Button Content="Read coding" Command="{Binding ReadCommand}" />
                <Button Content="Restore from a file..." Command="{Binding RestoreFileCommand}" />
              </StackPanel>
              <ItemsControl ItemsSource="{Binding Backups}" IsVisible="{Binding HasBackups}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:CodingBackupItem">
                    <Grid ColumnDefinitions="*,Auto" Margin="0,4">
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" />
                        <TextBlock Classes="muted small" Text="{Binding Detail}" />
                      </StackPanel>
                      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <Button Content="Compare with car" Command="{Binding CompareCommand}" />
                        <Button Content="Restore" Command="{Binding RestoreCommand}" />
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <SelectableTextBlock Classes="mono small" Text="{Binding Diff}" TextWrapping="Wrap" IsVisible="{Binding HasDiff}" />
            </StackPanel>
          </Border>

          <!-- NCS data and verification -->
          <Border Classes="panel" Padding="18,14">
            <StackPanel Spacing="10">
              <TextBlock FontWeight="SemiBold" Text="2. Settings by name (your NCS Expert data)" />
              <TextBlock Classes="muted small" Text="{Binding NcsStatus}" TextWrapping="Wrap" />
              <StackPanel Orientation="Horizontal" Spacing="10">
                <Button Content="Choose NCS data folder..." Command="{Binding ChooseNcsCommand}" />
                <Button Content="Verify with NCS Expert's trace file..." Command="{Binding VerifyCommand}" />
              </StackPanel>
              <TextBlock Classes="muted small" TextWrapping="Wrap"
                         Text="Writing unlocks only after verification: read this module once with NCS Expert, then pick the FSW_PSW.TRC it saved. Klemme15 must decode every setting exactly as NCS Expert did." />
              <TextBlock Text="{Binding Verification}" TextWrapping="Wrap" />
            </StackPanel>
          </Border>

          <!-- Toggles -->
          <StackPanel Spacing="8" IsVisible="{Binding HasToggles}">
            <TextBlock Classes="section" FontSize="16" Text="3. Comfort options" />
            <TextBlock Classes="muted small" TextWrapping="Wrap" IsVisible="{Binding NotExperimental}"
                       Text="Coding is experimental: switch on experimental functions on the Service page to change these." />
            <Border Classes="panel" Padding="14,10" IsVisible="{Binding HasPending}">
              <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" Margin="12,0,0,0">
                  <Button Classes="primary" Content="Code it" Command="{Binding ConfirmCommand}" Padding="14,6" />
                  <Button Content="Cancel" Command="{Binding CancelCommand}" Padding="12,6" />
                </StackPanel>
                <TextBlock Text="{Binding PendingText}" TextWrapping="Wrap" />
              </DockPanel>
            </Border>
            <ItemsControl ItemsSource="{Binding Toggles}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:CodingToggleItem">
                  <Border Classes="card" Margin="0,0,0,8" IsVisible="{Binding Available}">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Spacing="3">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Description}" TextWrapping="Wrap" />
                        <TextBlock Classes="muted small" Text="{Binding Caveat}" TextWrapping="Wrap" IsVisible="{Binding HasCaveat}" />
                      </StackPanel>
                      <StackPanel Grid.Column="1" Spacing="6" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Classes="mono small" Text="{Binding StateText}" HorizontalAlignment="Right" />
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <Button Content="Turn on" Command="{Binding TurnOnCommand}" IsEnabled="{Binding CanTurnOn}" />
                          <Button Content="Turn off" Command="{Binding TurnOffCommand}" IsEnabled="{Binding CanTurnOff}" />
                        </StackPanel>
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <!-- All settings -->
          <StackPanel Spacing="8" IsVisible="{Binding HasSettings}">
            <TextBlock Classes="section" FontSize="16" Text="All settings (read-only)" />
            <TextBox Watermark="Filter by name" Text="{Binding Filter}" MaxWidth="320" HorizontalAlignment="Left" />
            <ItemsControl ItemsSource="{Binding Settings}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:CodingSettingItem">
                  <Grid ColumnDefinitions="360,160,*" Margin="0,2">
                    <TextBlock Classes="mono small" Text="{Binding Name}" />
                    <TextBlock Grid.Column="1" Classes="mono small" Text="{Binding Value}" />
                    <TextBlock Grid.Column="2" Classes="muted small" Text="{Binding Group}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
