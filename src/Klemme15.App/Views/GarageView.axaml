<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Klemme15.App.ViewModels"
             xmlns:sys="using:System"
             xmlns:core="using:Klemme15.Core"
             xmlns:serial="using:Klemme15.Serial"
             xmlns:c="using:Klemme15.App.Controls"
             x:Class="Klemme15.App.Views.GarageView"
             x:DataType="vm:GarageViewModel">
  <Grid ColumnDefinitions="340,*">

    <!-- Left: pick the car -->
    <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0">
      <DockPanel Margin="28,26,20,20">
        <StackPanel DockPanel.Dock="Top" Spacing="16" Margin="0,0,0,14">
          <TextBlock Classes="title" Text="Garage" />
          <!-- Find my car: for owners who know "2011 328i" but not "E9x" -->
          <TextBox Text="{Binding Search}" Watermark="Find your car: 2011 328i, E92, X5..."
                   ToolTip.Tip="Type the model and year, or the chassis code from the sticker in the door jamb" />
          <StackPanel Spacing="6" IsVisible="{Binding IsSearching}">
            <ItemsControl ItemsSource="{Binding SearchResults}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Spacing="6" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:CarSearchResult">
                  <Button Classes="segment" Command="{Binding PickCommand}" HorizontalAlignment="Stretch">
                    <StackPanel Spacing="1">
                      <TextBlock Text="{Binding Title}" FontFamily="{DynamicResource DisplayFont}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding Detail}" Classes="muted small" TextWrapping="Wrap" />
                    </StackPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Classes="muted small" Text="{Binding SearchNote}" IsVisible="{Binding HasSearchNote}" TextWrapping="Wrap" />
          </StackPanel>
          <ItemsControl ItemsSource="{Binding Families}" IsVisible="{Binding NotSearching}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:FamilyOption">
                <Button Classes="segment" Classes.on="{Binding IsSelected}" Command="{Binding SelectCommand}" Margin="0,0,6,6" Padding="12,6"
                        ToolTip.Tip="{Binding Tip}">
                  <TextBlock Text="{Binding ChipName}" FontFamily="{DynamicResource DisplayFont}" FontSize="16" FontWeight="SemiBold" />
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
        <!-- Units for everything on screen; the files Klemme15 writes stay metric -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="12" Margin="0,12,0,0"
                    ToolTip.Tip="Units shown on screen and in reports. Recordings, snapshots and baselines stay metric so they can be shared.">
          <TextBlock Classes="muted small" Text="Units" VerticalAlignment="Center" />
          <RadioButton GroupName="units" Content="km, °C" IsChecked="{Binding MetricUnits}" />
          <RadioButton GroupName="units" Content="miles, °F" IsChecked="{Binding UsUnits}" />
        </StackPanel>
        <TextBlock DockPanel.Dock="Top" Classes="muted small" FontWeight="SemiBold" Text="{Binding ModelsHeading}" TextWrapping="Wrap"
                   Margin="0,0,0,6" IsVisible="{Binding NotSearching}" />
        <ListBox Classes="models" ItemsSource="{Binding Models}" SelectedItem="{Binding Model}" IsVisible="{Binding NotSearching}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="core:VehicleModel">
              <StackPanel Spacing="1">
                <DockPanel>
                  <TextBlock DockPanel.Dock="Right" Text="{Binding Years}" Classes="muted small" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding Name}" FontFamily="{DynamicResource DisplayFont}" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" />
                </DockPanel>
                <TextBlock Text="{Binding Engine}" Classes="muted small" TextWrapping="Wrap" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <!-- Right: the selected model -->
    <ScrollViewer Classes="page" Grid.Column="1">
      <StackPanel Margin="36,26,36,32" Spacing="22" MaxWidth="1000">
        <StackPanel Spacing="4">
          <TextBlock Text="{Binding ModelTitle}" FontFamily="{DynamicResource DisplayFont}" FontSize="44" FontWeight="SemiBold" />
          <TextBlock Text="{Binding Engine}" Classes="muted" FontSize="16" />
        </StackPanel>

        <!-- Start here: three steps for someone new, until a real car has been scanned or it's closed -->
        <Border Classes="panel" Padding="18,14" IsVisible="{Binding ShowStartHere}" BorderBrush="{DynamicResource LitBrush}" BorderThickness="1">
          <DockPanel>
            <Button DockPanel.Dock="Right" Classes="quiet" Content="Hide" Command="{Binding HideStartHereCommand}" VerticalAlignment="Top" />
            <StackPanel Spacing="6">
              <TextBlock Classes="section" FontSize="16" Text="Start here" />
              <TextBlock TextWrapping="Wrap" Text="1.  Pick your car on the left. Not sure of the chassis code? Type the model and year in the search box." />
              <TextBlock TextWrapping="Wrap" Text="{Binding StartCableStep, StringFormat='2.  {0}'}" />
              <TextBlock TextWrapping="Wrap" Text="3.  Press Run quick test. Klemme15 asks every module for its faults and explains what it finds. Nothing is changed on the car." />
              <TextBlock Classes="muted small" TextWrapping="Wrap" Text="No cable yet? Press Open demo car to look around first." />
            </StackPanel>
          </DockPanel>
        </Border>

        <!-- Your cars: every real car scanned on this computer -->
        <StackPanel Spacing="8" IsVisible="{Binding HasCars}">
          <TextBlock Classes="section" Text="Your cars" />
          <TextBlock Classes="muted small" Text="{Binding CarsNote}" TextWrapping="Wrap" />
          <ItemsControl ItemsSource="{Binding Cars}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:CarCardViewModel">
                <Border Classes="panel" Padding="14,12" Margin="0,0,12,12" Width="290">
                  <StackPanel Spacing="4">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Classes="muted small" Text="{Binding LastScan}" TextWrapping="Wrap" />
                    <TextBlock Classes="small" Text="{Binding Status}" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding HasTrend}">
                      <Ellipse Width="9" Height="9" Fill="{DynamicResource RedBrush}" IsVisible="{Binding TrendIsAct}" VerticalAlignment="Center" />
                      <Ellipse Width="9" Height="9" Fill="{DynamicResource AmberBrush}" IsVisible="{Binding TrendIsWatch}" VerticalAlignment="Center" />
                      <TextBlock Classes="small" Text="{Binding TopTrend}" TextWrapping="Wrap" MaxWidth="240" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,0" IsVisible="{Binding NotConfirming}">
                      <Button Content="Select" Command="{Binding SelectCommand}" Padding="12,5" ToolTip.Tip="Select this car's model below" />
                      <Button Classes="quiet" Content="Forget" Command="{Binding AskForgetCommand}" ToolTip.Tip="Delete this car's saved quick tests from this computer" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,0" IsVisible="{Binding Confirming}">
                      <TextBlock Classes="small" Text="Delete its history?" VerticalAlignment="Center" />
                      <Button Classes="primary" Content="Delete" Command="{Binding ForgetCommand}" Padding="12,5" />
                      <Button Content="Keep" Command="{Binding KeepCommand}" Padding="12,5" />
                    </StackPanel>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <!-- Shown until official fault meanings are set up: the full card is further down -->
        <Border Classes="panel" Padding="16,12" IsVisible="{Binding NeedsFaultData}">
          <DockPanel>
            <Button DockPanel.Dock="Right" Classes="primary" Content="{Binding DownloadButtonText}" Command="{Binding DownloadFaultDataCommand}" VerticalAlignment="Center" />
            <StackPanel Spacing="2" Margin="0,0,16,0">
              <TextBlock Text="Get BMW's own meaning for every fault code" FontWeight="SemiBold" TextWrapping="Wrap" />
              <TextBlock Classes="muted small" TextWrapping="Wrap"
                         Text="Optional: a one-time download from the independent project bmw-unified-db (third-party data derived from BMW's; you'll see what that means before anything downloads), or use your own ISTA/INPA files." />
              <TextBlock Classes="lit small" Text="{Binding DownloadText}" IsVisible="{Binding IsDownloading}" />
            </StackPanel>
          </DockPanel>
        </Border>

        <!-- Families still being mapped with testers (E36) -->
        <Border Classes="warn" IsVisible="{Binding HasFamilyNote}">
          <StackPanel Spacing="4">
            <TextBlock Text="Beta · in development" FontWeight="SemiBold" />
            <TextBlock Text="{Binding FamilyNote}" TextWrapping="Wrap" Classes="small" />
          </StackPanel>
        </Border>

        <Viewbox Stretch="Uniform" MaxHeight="400" HorizontalAlignment="Left">
          <Grid Width="1000" Height="460">
            <c:CarDrawing />
            <ItemsControl Classes="markers" ItemsSource="{Binding PreviewMarkers}" IsHitTestVisible="False">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><Canvas Width="1000" Height="460" ClipToBounds="False" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.Styles>
                <Style Selector="ItemsControl.markers > ContentPresenter" x:DataType="vm:MarkerViewModel">
                  <Setter Property="ClipToBounds" Value="False" />
                  <Setter Property="Canvas.Left" Value="{Binding Left}" />
                  <Setter Property="Canvas.Top" Value="{Binding Top}" />
                </Style>
              </ItemsControl.Styles>
            </ItemsControl>
          </Grid>
        </Viewbox>

        <!-- Specs -->
        <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto">
          <TextBlock Classes="muted small" Text="Drive" />
          <TextBlock Grid.Row="1" Text="{Binding Drive}" FontWeight="Medium" />
          <TextBlock Grid.Column="1" Classes="muted small" Text="Body styles" />
          <TextBlock Grid.Column="1" Grid.Row="1" Text="{Binding Body}" FontWeight="Medium" TextWrapping="Wrap" Margin="0,0,16,0" />
          <TextBlock Grid.Column="2" Classes="muted small" Text="Model years" />
          <TextBlock Grid.Column="2" Grid.Row="1" Text="{Binding Years}" FontWeight="Medium" />
        </Grid>

        <Border Classes="divider" />

        <!-- Actions -->
        <StackPanel Spacing="12">
          <WrapPanel>
            <Button Classes="primary" Content="Open demo car" Command="{Binding OpenDemoCommand}" Margin="0,0,10,8" />
            <Button Content="Connect to my car" Command="{Binding ShowCableCommand}" IsVisible="{Binding !ShowCable}" Margin="0,0,10,8" />
            <Button Content="Open a snapshot..." Command="{Binding OpenSnapshotCommand}" Margin="0,0,10,8"
                    ToolTip.Tip="Open a .k15 file someone shared and explore their car as it was, read-only" />
            <Button Content="Compare two snapshots..." Command="{Binding CompareSnapshotsCommand}" Margin="0,0,10,8"
                    ToolTip.Tip="Pick two .k15 files (before and after a repair, or two cars) and see which faults are gone, new or unchanged" />
            <Button Content="Disconnect" Command="{Binding DisconnectCommand}" IsVisible="{Binding IsConnected}" Margin="0,0,10,8" />
          </WrapPanel>
          <TextBlock Text="{Binding DemoSummary}" Classes="muted" TextWrapping="Wrap" />
          <TextBlock Text="{Binding ConnectedText}" Classes="lit" IsVisible="{Binding IsConnected}" TextWrapping="Wrap" />
          <TextBlock Text="{Binding CompareResult}" IsVisible="{Binding HasCompareResult}" TextWrapping="Wrap" />
          <TextBlock Classes="error" Text="{Binding Error}" IsVisible="{Binding HasError}" />
        </StackPanel>

        <!-- Official BMW fault texts: the user's own BMW files and/or the optional third-party download -->
        <Border Classes="panel" Padding="20">
          <StackPanel Spacing="10">
            <TextBlock Classes="section" Text="Official BMW fault meanings" />
            <TextBlock Classes="muted" TextWrapping="Wrap"
                       Text="Klemme15 explains codes with its own researched meanings. For BMW's own text on every code of every module, add one of these. Both stay on your computer." />
            <TextBlock Text="{Binding FaultDataStatus}" TextWrapping="Wrap" />
            <WrapPanel>
              <Button Margin="0,0,8,8" Classes="primary" Content="{Binding DownloadButtonText}" Command="{Binding DownloadFaultDataCommand}" />
              <Button Margin="0,0,8,8" Content="{Binding DownloadReadingsText}" Command="{Binding DownloadReadingsCommand}"
                      ToolTip.Tip="Engine values on the Readings page without ISTA: downloads the full database once and keeps only the engine tables (a few MB)" />
              <Button Margin="0,0,8,8" Content="Use my BMW files (ISTA / INPA)" Command="{Binding ChooseEcuFolderCommand}" />
            </WrapPanel>
            <TextBlock Classes="lit" Text="{Binding DownloadText}" IsVisible="{Binding IsDownloading}" />
            <TextBlock Classes="muted small" TextWrapping="Wrap"
                       Text="The download is bmw-unified-db, a free community project on GitHub (not part of Klemme15). Its fault texts are derived from BMW's diagnostic data, which BMW owns; that project publishes them for right-to-repair. Klemme15 checks the file's checksum and keeps only the modules for your car family." />
            <StackPanel Orientation="Horizontal" Spacing="14">
              <Button Classes="quiet" Content="{Binding FaultDataProject}" Command="{Binding OpenFaultDataPageCommand}" />
              <Button Classes="quiet" Content="Data sources and licences" Command="{Binding OpenFaultDataLicenseCommand}" />
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- Cable setup, shown on request -->
        <Border Classes="panel" Padding="20" IsVisible="{Binding ShowCable}">
          <StackPanel Spacing="14">
            <TextBlock Classes="section" Text="Connect the K+DCAN cable" />
            <TextBlock Text="{Binding CableHint}" Classes="muted" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <ComboBox ItemsSource="{Binding Ports}" SelectedItem="{Binding Port}" MinWidth="320" PlaceholderText="No cable found">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="serial:PortInfo">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding Description}" Classes="muted" />
                      <TextBlock Text="K+DCAN" Classes="lit" IsVisible="{Binding LikelyKDCan}" />
                    </StackPanel>
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <Button Content="Refresh" Command="{Binding RefreshPortsCommand}" />
              <Button Content="Check cable" Command="{Binding CheckCableCommand}"
                      ToolTip.Tip="Checks the cable before talking to the car: genuine FTDI chip or a likely clone, the latency setting, and whether another program has the port" />
            </StackPanel>
            <ItemsControl ItemsSource="{Binding CableFindings}" IsVisible="{Binding HasCableFindings}" MaxWidth="760" HorizontalAlignment="Left">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:CableFindingViewModel">
                  <Grid ColumnDefinitions="22,*" Margin="0,3">
                    <Grid>
                      <Ellipse Width="11" Height="11" Fill="{DynamicResource RedBrush}" IsVisible="{Binding IsWarn}" VerticalAlignment="Top" Margin="0,4,0,0" HorizontalAlignment="Left" />
                      <Ellipse Width="11" Height="11" Fill="{DynamicResource AmberBrush}" IsVisible="{Binding IsAsk}" VerticalAlignment="Top" Margin="0,4,0,0" HorizontalAlignment="Left" />
                      <Ellipse Width="11" Height="11" Fill="{DynamicResource LitBrush}" IsVisible="{Binding IsGood}" VerticalAlignment="Top" Margin="0,4,0,0" HorizontalAlignment="Left" />
                      <Ellipse Width="11" Height="11" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.5" IsVisible="{Binding IsInfo}" VerticalAlignment="Top" Margin="0,4,0,0" HorizontalAlignment="Left" />
                    </Grid>
                    <StackPanel Grid.Column="1" Spacing="1">
                      <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                      <TextBlock Classes="muted small" Text="{Binding Detail}" TextWrapping="Wrap" />
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Classes="muted small" IsVisible="{Binding NoPorts}" TextWrapping="Wrap"
                       Text="Plug the cable in, wait for its driver to load, then press Refresh." />
            <StackPanel Spacing="4">
              <TextBox Text="{Binding NetworkAddress}" Watermark="Or a Wi-Fi cable: rfc2217://192.168.4.1:2217" MaxWidth="420" HorizontalAlignment="Left" />
              <TextBlock Classes="muted small" Text="{Binding NetworkHint}" TextWrapping="Wrap" />
            </StackPanel>
            <CheckBox IsChecked="{Binding TrustDsr}" Content="My cable reports ignition (stop me if the key is off)" />
            <CheckBox IsChecked="{Binding UseEdiabas}" IsEnabled="{Binding EdiabasAvailable}" Content="Use my own BMW files (EDIABAS mode): every module's faults, readings and service functions"
                      ToolTip.Tip="Runs the BMW files you already have from an ISTA, INPA or EDIABAS install on this computer. Windows only." />
            <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding UseEdiabas}">
              <TextBox Text="{Binding EdiabasPath}" Watermark="C:\EDIABAS\Ecu" MinWidth="320" />
              <Button Content="Browse" Command="{Binding BrowseEdiabasCommand}" />
            </StackPanel>
            <TextBlock Classes="muted small" Text="{Binding EdiabasStatus}" TextWrapping="Wrap" IsVisible="{Binding EdiabasAvailable}" />
            <Button Classes="primary" Content="Connect" Command="{Binding ConnectCarCommand}" HorizontalAlignment="Left" />
            <TextBlock Classes="error" Text="{Binding Error}" IsVisible="{Binding ShowConnectHelp}" TextWrapping="Wrap" />
            <!-- The car didn't answer: what to check, in order -->
            <Border Classes="warn" IsVisible="{Binding ShowConnectHelp}">
              <StackPanel Spacing="4">
                <TextBlock Text="Can't connect? Check these in order" FontWeight="SemiBold" />
                <ItemsControl ItemsSource="{Binding ConnectHelp}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="sys:String">
                      <TextBlock Classes="small" Text="{Binding StringFormat='• {0}'}" TextWrapping="Wrap" Margin="0,1" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Classes="quiet" Content="Open the cable guide" Command="{Binding OpenCableGuideCommand}" HorizontalAlignment="Left" Padding="0,2" />
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
