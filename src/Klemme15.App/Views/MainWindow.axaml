<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Klemme15.App.ViewModels"
        xmlns:views="using:Klemme15.App.Views"
        xmlns:controls="using:Klemme15.App.Controls"
        x:Class="Klemme15.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Klemme15"
        Icon="avares://Klemme15/Assets/Logo/klemme15.ico"
        Width="1320" Height="840" MinWidth="980" MinHeight="620">

  <Window.DataTemplates>
    <DataTemplate DataType="vm:GarageViewModel"><views:GarageView /></DataTemplate>
    <DataTemplate DataType="vm:VehicleViewModel"><views:VehicleView /></DataTemplate>
    <DataTemplate DataType="vm:FaultsViewModel"><views:FaultsView /></DataTemplate>
    <DataTemplate DataType="vm:ReadingsViewModel"><views:ReadingsView /></DataTemplate>
    <DataTemplate DataType="vm:ServiceViewModel"><views:ServiceView /></DataTemplate>
    <DataTemplate DataType="vm:TestsViewModel"><views:TestsView /></DataTemplate>
    <DataTemplate DataType="vm:CodingViewModel"><views:CodingView /></DataTemplate>
    <DataTemplate DataType="vm:AnalyseViewModel"><views:AnalyseView /></DataTemplate>
    <DataTemplate DataType="vm:LiveViewModel"><views:LiveView /></DataTemplate>
    <DataTemplate DataType="vm:ExpertViewModel"><views:ExpertView /></DataTemplate>
    <DataTemplate DataType="vm:LogViewModel"><views:LogView /></DataTemplate>
  </Window.DataTemplates>

  <Grid ColumnDefinitions="92,*">
    <!-- Navigation rail -->
    <Border Background="{DynamicResource RailBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="0,14,0,12" HorizontalAlignment="Center" Spacing="6">
          <controls:LogoMark Width="44" Height="44" HorizontalAlignment="Center" />
          <TextBlock Text="Klemme15" FontFamily="{DynamicResource DisplayFont}" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,10" Spacing="6">
          <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Margin="12,0" Padding="0,8,0,0">
            <WrapPanel HorizontalAlignment="Center" MaxWidth="84" ItemWidth="28" ItemHeight="28">
              <Button Classes="quiet" Command="{Binding AboutCommand}" ToolTip.Tip="About Klemme15" Width="28" Height="28" Padding="0">
                <PathIcon Data="{x:Static vm:Icons.Info}" Width="14" Height="14" Foreground="{DynamicResource MutedBrush}" />
              </Button>
              <Button Classes="quiet" Command="{Binding SupportCommand}" ToolTip.Tip="Help and support" Width="28" Height="28" Padding="0">
                <PathIcon Data="{x:Static vm:Icons.Support}" Width="14" Height="14" Foreground="{DynamicResource MutedBrush}" />
              </Button>
              <Button Classes="quiet" Command="{Binding PrivacyCommand}" ToolTip.Tip="Privacy policy" Width="28" Height="28" Padding="0">
                <PathIcon Data="{x:Static vm:Icons.Privacy}" Width="14" Height="14" Foreground="{DynamicResource MutedBrush}" />
              </Button>
              <Button Classes="quiet" Command="{Binding CoffeeCommand}" ToolTip.Tip="Buy me a coffee" Width="28" Height="28" Padding="0" IsVisible="{Binding HasCoffee}">
                <PathIcon Data="{x:Static vm:Icons.Coffee}" Width="14" Height="14" Foreground="{DynamicResource MutedBrush}" />
              </Button>
              <Button Classes="quiet" Command="{Binding ToggleThemeCommand}" ToolTip.Tip="Switch between dark and light" Width="28" Height="28" Padding="0">
                <PathIcon Data="{x:Static vm:Icons.Theme}" Width="14" Height="14" Foreground="{DynamicResource MutedBrush}" />
              </Button>
            </WrapPanel>
          </Border>
          <TextBlock Text="{Binding Version}" Classes="muted" FontSize="10" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="4,0" />
        </StackPanel>
        <ListBox x:Name="Rail" Classes="rail" ItemsSource="{Binding Pages}" SelectedItem="{Binding CurrentPage}"
                 ScrollViewer.VerticalScrollBarVisibility="Hidden" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:PageViewModel">
              <StackPanel Spacing="4" HorizontalAlignment="Center" ToolTip.Tip="{Binding Title}">
                <PathIcon Data="{Binding Icon}" Width="18" Height="18" HorizontalAlignment="Center" />
                <TextBlock Classes="raillabel" Text="{Binding Title}" FontSize="11.5" FontWeight="Medium" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="72" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <Grid Grid.Column="1" RowDefinitions="Auto,*">
      <!-- Header: which car, how it's connected -->
      <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="28,14">
        <DockPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <Border Classes="panel" Padding="10,5" CornerRadius="14">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Ellipse Width="8" Height="8" Fill="{DynamicResource LitBrush}" IsVisible="{Binding IsConnected}" VerticalAlignment="Center" />
                <Ellipse Width="8" Height="8" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.5" IsVisible="{Binding !IsConnected}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Connection}" FontSize="13" VerticalAlignment="Center" />
              </StackPanel>
            </Border>
          </StackPanel>
          <Grid ColumnDefinitions="Auto,*" VerticalAlignment="Center" Margin="0,0,12,0">
            <TextBlock Text="{Binding CarTitle}" FontFamily="{DynamicResource DisplayFont}" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding CarSubtitle}" Classes="muted" VerticalAlignment="Center" Margin="14,3,0,0"
                       TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding CarSubtitle}" />
          </Grid>
        </DockPanel>
      </Border>

      <ContentControl Grid.Row="1" Content="{Binding CurrentPage}" />
    </Grid>
  </Grid>
</Window>
