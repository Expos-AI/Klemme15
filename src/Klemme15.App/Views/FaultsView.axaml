<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="using:System"
             xmlns:vm="using:Klemme15.App.ViewModels"
             x:Class="Klemme15.App.Views.FaultsView"
             x:DataType="vm:FaultsViewModel">
  <UserControl.DataTemplates>
    <DataTemplate DataType="vm:GuideViewModel">
      <StackPanel Spacing="8">
                              <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                              <TextBlock Classes="muted" Text="{Binding Summary}" TextWrapping="Wrap" />
                              <ItemsControl ItemsSource="{Binding Safety}" IsVisible="{Binding HasSafety}">
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate x:DataType="sys:String">
                                    <TextBlock Classes="red small" Text="{Binding}" TextWrapping="Wrap" FontWeight="SemiBold" />
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>
                              <ItemsControl ItemsSource="{Binding Steps}">
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate x:DataType="vm:GuideStepViewModel">
                                    <Grid ColumnDefinitions="26,*" Margin="0,3">
                                      <TextBlock Classes="lit" Text="{Binding Number}" FontWeight="SemiBold" />
                                      <StackPanel Grid.Column="1" Spacing="4">
                                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                          <Button Classes="quiet" Content="Show readings" Command="{Binding ReadingsCommand}" IsVisible="{Binding HasReadings}" FontSize="12" Padding="4,0" />
                                          <Button Classes="quiet" Content="Open Live data" Command="{Binding LiveCommand}" IsVisible="{Binding HasLive}" FontSize="12" Padding="4,0" />
                                        </StackPanel>
                                      </StackPanel>
                                    </Grid>
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>
                              <ItemsControl ItemsSource="{Binding Sources}" IsVisible="{Binding HasSources}">
                                <ItemsControl.ItemsPanel>
                                  <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate x:DataType="vm:SourceLink">
                                    <Button Classes="quiet" Content="{Binding Label}" Command="{Binding OpenCommand}" FontSize="12" Padding="4,0" ToolTip.Tip="{Binding Url}" />
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>
                              <TextBlock Classes="muted small" TextWrapping="Wrap"
                                         Text="Guides are written by Klemme15 contributors as a starting point. If you're unsure, or a step needs tools you don't have, ask a mechanic." />
                            </StackPanel>
    </DataTemplate>
  </UserControl.DataTemplates>
  <DockPanel Margin="36,26,36,0">
    <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,18">
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="Read again" Command="{Binding RefreshCommand}" VerticalAlignment="Center" />
        <Button DockPanel.Dock="Right" Content="{Binding Purchase.ToggleText}" Command="{Binding Purchase.ToggleCommand}" VerticalAlignment="Center" Margin="0,0,8,0"
                ToolTip.Tip="A pre-purchase check for someone looking at a used car: mileage records, safety faults, signs of cleared codes" />
        <Button DockPanel.Dock="Right" Classes="primary" Content="{Binding Share.ToggleText}" Command="{Binding Share.ToggleCommand}" VerticalAlignment="Center" Margin="0,0,8,0"
                ToolTip.Tip="Save the whole car as a .k15 file someone else can open in Klemme15 and explore, read-only" />
        <TextBlock Classes="title" Text="Faults" />
      </DockPanel>
      <!-- Buying this car? -->
      <Border Classes="panel" Padding="18,14" IsVisible="{Binding Purchase.IsOpen}" BorderBrush="{DynamicResource LitBrush}" BorderThickness="1" MaxWidth="980" HorizontalAlignment="Left">
        <StackPanel Spacing="8" DataContext="{Binding Purchase}" x:DataType="vm:PurchaseCheckViewModel">
          <TextBlock Classes="section" FontSize="16" Text="{Binding Headline}" TextWrapping="Wrap" />
          <TextBlock Classes="muted small" TextWrapping="Wrap"
                     Text="Looking at a used car? Type the odometer reading from the dash: Klemme15 compares it with the mileage the car's modules recorded, and looks for safety faults and signs of freshly cleared codes. Read-only." />
          <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBox Watermark="Odometer reading" Text="{Binding Odometer}" Width="180" />
            <CheckBox Content="Miles" IsChecked="{Binding Miles}" VerticalAlignment="Center" />
            <Button Content="Save buyer's report..." Command="{Binding SaveCommand}" />
          </StackPanel>
          <ItemsControl ItemsSource="{Binding Items}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:PurchaseItemViewModel">
                <Grid ColumnDefinitions="22,*" Margin="0,4">
                  <Grid>
                    <Ellipse Width="11" Height="11" Fill="{DynamicResource RedBrush}" IsVisible="{Binding IsWarn}" VerticalAlignment="Top" Margin="0,4,0,0" HorizontalAlignment="Left" />
                    <Ellipse Width="11" Height="11" Fill="{DynamicResource AmberBrush}" IsVisible="{Binding IsAsk}" VerticalAlignment="Top" Margin="0,4,0,0" HorizontalAlignment="Left" />
                    <Ellipse Width="11" Height="11" Fill="{DynamicResource LitBrush}" IsVisible="{Binding IsGood}" VerticalAlignment="Top" Margin="0,4,0,0" HorizontalAlignment="Left" />
                    <Ellipse Width="11" Height="11" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.5" IsVisible="{Binding IsInfo}" VerticalAlignment="Top" Margin="0,4,0,0" HorizontalAlignment="Left" />
                  </Grid>
                  <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Classes="muted small" Text="{Binding Detail}" TextWrapping="Wrap" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Classes="small" Text="Not covered" FontWeight="SemiBold" />
          <ItemsControl ItemsSource="{Binding NotChecked}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="sys:String">
                <TextBlock Classes="muted small" Text="{Binding StringFormat='• {0}'}" TextWrapping="Wrap" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
      <!-- Share snapshot -->
      <Border Classes="panel" Padding="18,14" IsVisible="{Binding Share.IsOpen}" BorderBrush="{DynamicResource LitBrush}" BorderThickness="1" MaxWidth="980" HorizontalAlignment="Left">
        <StackPanel Spacing="8" DataContext="{Binding Share}" x:DataType="vm:SnapshotShareViewModel">
          <TextBlock Classes="section" FontSize="16" Text="Share a snapshot of your car" />
          <TextBlock Classes="muted small" TextWrapping="Wrap"
                     Text="Saves the whole car as it is now in one .k15 file. Attach it to your E90Post, Reddit or GitHub post: anyone with Klemme15 opens it in the Garage and explores your car as if they were plugged in, read-only. Klemme15 uploads nothing itself." />
          <TextBox Watermark="What's wrong, and what have you tried? (shown to whoever opens it)" Text="{Binding Note}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" />
          <TextBlock Classes="small" Text="{Binding Contents}" TextWrapping="Wrap" />
          <CheckBox IsChecked="{Binding IncludeLive}"><TextBlock Text="{Binding LiveText}" TextWrapping="Wrap" /></CheckBox>
          <CheckBox IsChecked="{Binding IncludeTests}"><TextBlock Text="{Binding TestsText}" TextWrapping="Wrap" /></CheckBox>
          <CheckBox IsChecked="{Binding IncludeCoding}"><TextBlock Text="{Binding CodingText}" TextWrapping="Wrap" /></CheckBox>
          <CheckBox IsChecked="{Binding IncludeLog}"><TextBlock Text="Traffic log (for bug reports; VIN scrubbed)" TextWrapping="Wrap" /></CheckBox>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Classes="primary" Content="Save snapshot..." Command="{Binding SaveCommand}" />
          </StackPanel>
          <TextBlock Classes="small" Text="{Binding Status}" TextWrapping="Wrap" IsVisible="{Binding HasStatus}" />
        </StackPanel>
      </Border>
      <TextBlock Text="{Binding Headline}" Classes="muted" FontSize="16" />
      <DockPanel>
        <CheckBox DockPanel.Dock="Right" Content="Show background entries" IsChecked="{Binding ShowBackground}" IsVisible="{Binding HasBackground}"
                  ToolTip.Tip="Info and shadow memory, and faults typically left behind by battery work" />
        <TextBlock Text="{Binding Verdict}" TextWrapping="Wrap" VerticalAlignment="Center" />
      </DockPanel>
      <TextBlock Classes="error" Text="{Binding Error}" IsVisible="{Binding HasError}" />
      <TextBlock Classes="muted" Text="{Binding EmptyText}" IsVisible="{Binding IsEmpty}" TextWrapping="Wrap" MaxWidth="560" HorizontalAlignment="Left" />
    </StackPanel>

    <ScrollViewer>
      <StackPanel MaxWidth="980" HorizontalAlignment="Left">
      <!-- Health over time: what changed across every scan of this car on this computer -->
      <Border Classes="panel" Padding="18,14" Margin="0,0,0,22" IsVisible="{Binding ShowTrendsCard}">
        <StackPanel Spacing="10">
          <TextBlock Classes="section" Text="{Binding TrendsHeadline}" TextWrapping="Wrap" />
          <TextBlock Classes="muted small" Text="{Binding TrendsNote}" TextWrapping="Wrap" />
          <ItemsControl ItemsSource="{Binding Trends}" IsVisible="{Binding HasTrends}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:TrendItem">
                <Grid ColumnDefinitions="22,*" Margin="0,4">
                  <Grid>
                    <Ellipse Width="11" Height="11" Fill="{DynamicResource RedBrush}" IsVisible="{Binding IsAct}" VerticalAlignment="Top" Margin="0,4,0,0" HorizontalAlignment="Left" />
                    <Ellipse Width="11" Height="11" Fill="{DynamicResource AmberBrush}" IsVisible="{Binding IsWatch}" VerticalAlignment="Top" Margin="0,4,0,0" HorizontalAlignment="Left" />
                    <Ellipse Width="11" Height="11" Fill="{DynamicResource LitBrush}" IsVisible="{Binding IsInfo}" VerticalAlignment="Top" Margin="0,4,0,0" HorizontalAlignment="Left" />
                  </Grid>
                  <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Classes="muted small" Text="{Binding Detail}" TextWrapping="Wrap" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
      <!-- The car's story: the cluster's warning history, explained -->
      <Border Classes="panel" Padding="18,14" Margin="0,0,0,22" IsVisible="{Binding HasStory}">
        <StackPanel Spacing="10">
          <DockPanel>
            <Button DockPanel.Dock="Right" Classes="quiet" Content="{Binding StoryToggleText}" Command="{Binding ToggleStoryCommand}" VerticalAlignment="Center" />
            <TextBlock Classes="section" Text="{Binding StoryHeadline}" TextWrapping="Wrap" VerticalAlignment="Center" />
          </DockPanel>
          <TextBlock Classes="muted small" TextWrapping="Wrap" IsVisible="{Binding StoryOpen}"
                     Text="Every dash message your cluster has shown and still remembers, with the mileage, grouped into what happened. Newest first." />
          <ItemsControl ItemsSource="{Binding Story}" IsVisible="{Binding StoryOpen}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:StoryItem">
                <Grid ColumnDefinitions="170,22,*" Margin="0,4">
                  <TextBlock Classes="mono small" Text="{Binding When}" TextWrapping="Wrap" Margin="0,2,8,0" />
                  <Grid Grid.Column="1">
                    <Ellipse Width="11" Height="11" Fill="{DynamicResource RedBrush}" IsVisible="{Binding IsRed}" VerticalAlignment="Top" Margin="0,4,0,0" HorizontalAlignment="Left" />
                    <Ellipse Width="11" Height="11" Fill="{DynamicResource AmberBrush}" IsVisible="{Binding IsBattery}" VerticalAlignment="Top" Margin="0,4,0,0" HorizontalAlignment="Left" />
                    <Ellipse Width="11" Height="11" Fill="{DynamicResource LitBrush}" IsVisible="{Binding IsOther}" VerticalAlignment="Top" Margin="0,4,0,0" HorizontalAlignment="Left" />
                  </Grid>
                  <StackPanel Grid.Column="2" Spacing="2">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Classes="muted small" Text="{Binding Explanation}" TextWrapping="Wrap" />
                    <TextBlock Classes="mono muted small" Text="{Binding Codes}" TextWrapping="Wrap" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
      <ItemsControl ItemsSource="{Binding Groups}" Margin="0,0,0,32">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:FaultGroupViewModel">
            <StackPanel Spacing="4" Margin="0,0,0,26">
              <!-- module header -->
              <DockPanel Margin="0,0,0,6">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                  <Button Classes="quiet" Content="Readings" Command="{Binding ReadingsCommand}" IsVisible="{Binding CanOpenReadings}"
                          ToolTip.Tip="See this module's live values (sensor readings, switch states, learned values)" />
                  <Button Classes="quiet" Content="Clear fault memory" Command="{Binding AskClearCommand}" IsVisible="{Binding NotConfirming}" />
                  <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding Confirming}">
                    <TextBlock Text="Clear faults and Shadow / Info memory?" VerticalAlignment="Center" ToolTip.Tip="Clears this module's fault memory and its Shadow / Info memory, as ISTA does" />
                    <Button Classes="primary" Content="Clear" Command="{Binding ClearCommand}" Padding="14,6" />
                    <Button Content="Keep" Command="{Binding CancelClearCommand}" Padding="12,6" />
                  </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="12">
                  <TextBlock Classes="section" Text="{Binding Name}" />
                  <TextBlock Classes="muted small" Text="{Binding Address}" VerticalAlignment="Center" />
                  <TextBlock Classes="muted small" Text="{Binding CountText}" VerticalAlignment="Center" />
                </StackPanel>
              </DockPanel>
              <TextBlock Classes="muted" Text="{Binding Message}" IsVisible="{Binding HasMessage}" TextWrapping="Wrap" Margin="0,0,0,6" />

              <ItemsControl ItemsSource="{Binding Faults}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:FaultItemViewModel">
                    <Border Classes="panel" Padding="0" Margin="0,0,0,8">
                      <Grid ColumnDefinitions="4,110,*,Auto">
                        <Border Classes="faultbar" Classes.active="{Binding IsActive}" CornerRadius="6,0,0,6" />
                        <StackPanel Grid.Column="1" Margin="18,14,8,14" Spacing="6">
                          <SelectableTextBlock Classes="code" Text="{Binding Code}" />
                          <Border Classes="statechip" Classes.active="{Binding IsActive}" HorizontalAlignment="Left">
                            <TextBlock Text="{Binding StateText}" />
                          </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="8,14,12,14" Spacing="6">
                          <SelectableTextBlock Text="{Binding Description}" TextWrapping="Wrap" FontSize="15" />
                          <TextBlock TextWrapping="Wrap" Classes="small" Classes.red="{Binding FixNow}" Classes.amber="{Binding CheckIt}" Classes.muted="{Binding IsBackground}">
                            <Run Text="{Binding VerdictLabel}" FontWeight="Bold" />
                            <Run Text=": " />
                            <Run Text="{Binding VerdictAdvice}" />
                          </TextBlock>
                          <SelectableTextBlock Classes="lit" Text="{Binding Tip}" TextWrapping="Wrap" IsVisible="{Binding HasTip}" />
                          <SelectableTextBlock Classes="muted small" Text="{Binding OfficialLine}" TextWrapping="Wrap" IsVisible="{Binding HasOfficialLine}" />
                          <TextBlock Classes="muted small" Text="{Binding VariantLine}" TextWrapping="Wrap" IsVisible="{Binding HasVariantLine}" />
                          <SelectableTextBlock Classes="muted small" Text="{Binding AlternativesText}" TextWrapping="Wrap" IsVisible="{Binding HasAlternatives}" />
                          <!-- Troubleshooting guide -->
                          <Border IsVisible="{Binding GuideOpen}" Padding="14,12" Margin="0,6,0,0" CornerRadius="6"
                                  Background="{DynamicResource LitSoftBrush}">
                            <ContentControl Content="{Binding Guide}" />
                          </Border>
                          <!-- Multimeter check -->
                          <Border IsVisible="{Binding CheckOpen}" Padding="14,12" Margin="0,6,0,0" CornerRadius="6"
                                  Background="{DynamicResource LitSoftBrush}">
                            <ContentControl Content="{Binding Check}" />
                          </Border>
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Classes="muted small" Text="Check here:" />
                            <TextBlock Classes="small" Text="{Binding Where}" TextWrapping="Wrap" />
                          </StackPanel>
                          <TextBlock Classes="muted small" Text="{Binding Details}" TextWrapping="Wrap" IsVisible="{Binding HasDetails}" />
                          <WrapPanel>
                            <TextBlock Classes="muted small" FontStyle="Italic" Text="{Binding Provenance}" IsVisible="{Binding HasProvenance}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <Button Classes="quiet" Content="Translate" Command="{Binding TranslateCommand}" IsVisible="{Binding CanTranslate}" ToolTip.Tip="Open BMW's German text in Google Translate" FontSize="12" Padding="4,0" />
                            <ItemsControl ItemsSource="{Binding SourceLinks}" IsVisible="{Binding HasSourceLinks}">
                              <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                              </ItemsControl.ItemsPanel>
                              <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:SourceLink">
                                  <Button Classes="quiet" Content="{Binding Label}" Command="{Binding OpenCommand}" ToolTip.Tip="{Binding Url}" FontSize="12" Padding="4,0" />
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                          </WrapPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="0,0,14,0" Spacing="4">
                          <Button Classes="quiet" Content="Show on car" Command="{Binding ShowCommand}" HorizontalAlignment="Right" />
                          <Button Classes="quiet" Content="{Binding GuideButtonText}" Command="{Binding ToggleGuideCommand}" IsVisible="{Binding HasGuide}" HorizontalAlignment="Right"
                                  ToolTip.Tip="Step-by-step checks for this kind of fault" />
                          <Button Classes="quiet" Content="{Binding ChainButtonText}" Command="{Binding RunChainCommand}" IsVisible="{Binding HasChain}" HorizontalAlignment="Right"
                                  ToolTip.Tip="{Binding ChainTitle}" />
                          <Button Classes="quiet" Content="{Binding CheckButtonText}" Command="{Binding ToggleCheckCommand}" IsVisible="{Binding HasCheck}" HorizontalAlignment="Right"
                                  ToolTip.Tip="Test the part with a multimeter or a swap before buying it" />
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
