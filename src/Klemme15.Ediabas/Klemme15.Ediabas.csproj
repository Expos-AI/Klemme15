<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Must match a target framework EdiabasLib builds for. -->
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <RootNamespace>Klemme15.Ediabas</RootNamespace>
    <Description>EDIABAS backend: runs the user's own SGBD files through EdiabasLib (GPLv3, by Ulrich Holeschak).</Description>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Klemme15.Core\Klemme15.Core.csproj" />
    <!-- fetched by scripts/get-ediabaslib.ps1 into external/ediabaslib (https://github.com/uholeschak/ediabaslib) -->
    <ProjectReference Include="..\..\external\ediabaslib\EdiabasLib\EdiabasLib\EdiabasLib.csproj" />
  </ItemGroup>
</Project>
