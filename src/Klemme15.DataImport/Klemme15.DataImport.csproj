<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Klemme15.DataImport</RootNamespace>
    <Description>Optional import of measurement tables from the full bmw-unified-db download (SQLite) on the user's computer.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Klemme15.Data\Klemme15.Data.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.14" />
    <!-- Patched native SQLite (3.53.3): 2.1.11 and older bundle a SQLite affected by CVE-2025-6965 (GHSA-2m69-gcr7-jv3q). -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
  </ItemGroup>
</Project>
