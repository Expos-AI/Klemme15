<Project>
  <!-- Only for Klemme15's own projects, never the external/ submodules. -->
  <PropertyGroup Condition="!$(MSBuildProjectDirectory.Replace('\', '/').Contains('/external/'))">
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <Authors>Klemme15 contributors</Authors>
    <Copyright>Klemme15 contributors, GPL-3.0-or-later</Copyright>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
    <Version>0.5.1</Version>
  </PropertyGroup>
</Project>
